---
import Icon from './Icon.astro';
import type { Lang } from '../../i18n/ui';
import { kitUi } from '../i18n';
import type { AppMeta, InstallContent } from '../types';

interface Props {
  app: AppMeta;
  lang: Lang;
  install: InstallContent;
  labels: { title: string; tabs: { install: string; permissions?: string; faq: string } };
  cardClass?: string;
}
const { app, lang, install, labels, cardClass } = Astro.props;
const ui = kitUi[lang];
const hasPermissions = Boolean(install.permissions?.length && labels.tabs.permissions);
const tabs = [
  { id: 'install', label: labels.tabs.install },
  ...(hasPermissions ? [{ id: 'permissions', label: labels.tabs.permissions! }] : []),
  { id: 'faq', label: labels.tabs.faq },
];
---

<dialog id="k-sheet" class="k-sheet" aria-labelledby="k-sheet-title" data-k-sheet>
  <div class="flex h-full max-h-[inherit] flex-col">
    <header class="flex flex-none items-center justify-between gap-4 px-5 pt-5 pb-3 md:px-7 md:pt-7">
      <div class="flex items-center gap-3">
        <img src={app.icon} alt="" width="40" height="40" class="h-10 w-10 rounded-xl" />
        <h2 id="k-sheet-title" class="font-display text-2xl font-bold">{labels.title}</h2>
      </div>
      <button
        type="button"
        class="grid h-10 w-10 flex-none place-items-center rounded-full bg-c-surface-variant text-c-text"
        data-k-sheet-close
        aria-label={ui.close}
      >
        <Icon name="x" class="h-5 w-5" />
      </button>
    </header>

    <div class="flex-none px-5 md:px-7" role="tablist" aria-label={labels.title}>
      <div class="grid auto-cols-fr grid-flow-col gap-1 rounded-full bg-c-surface-variant p-1">
        {
          tabs.map((t, i) => (
            <button
              type="button"
              role="tab"
              id={`k-tab-${t.id}`}
              aria-controls={`k-panel-${t.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-k-tab={t.id}
              class="min-w-0 truncate rounded-full px-0.5 py-2 font-display text-[0.8rem] min-[340px]:px-2 min-[340px]:text-[0.95rem] font-semibold text-c-muted transition-colors aria-selected:bg-c-primary aria-selected:text-c-on-primary"
            >
              {t.label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-5 pt-5 pb-8 md:px-7">
      <section id="k-panel-install" role="tabpanel" aria-labelledby="k-tab-install" data-k-panel="install">
        <ol class="grid gap-4">
          {
            install.steps.map((s, i) => (
              <li class="flex gap-4">
                <span class="k-tone-primary grid h-10 w-10 flex-none place-items-center rounded-full font-display text-lg font-bold">
                  {i + 1}
                </span>
                <div class="pt-1">
                  <h3 class="text-lg font-semibold">{s.title}</h3>
                  <p class="text-[0.97rem] text-c-muted">{s.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      {
        hasPermissions && (
        <section id="k-panel-permissions" role="tabpanel" aria-labelledby="k-tab-permissions" data-k-panel="permissions" hidden>
          <p class="text-[0.97rem] text-c-muted">{install.permissionsIntro}</p>
          <ul class:list={['mt-4 divide-y-2 divide-dashed divide-c-outline overflow-hidden', cardClass]}>
            {
              install.permissions!.map((p) => (
                <li class="flex items-start gap-3 px-4 py-3">
                  <span class="k-tone-primary grid h-9 w-9 flex-none place-items-center rounded-xl">
                    <Icon name={p.icon} class="h-[1.1rem] w-[1.1rem]" />
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
                      <span class="font-display leading-tight font-semibold">{p.title}</span>
                      {p.badge && (
                        <span class="k-tone-accent rounded-md px-1.5 py-0.5 text-[0.65rem] font-extrabold tracking-[0.1em] uppercase">
                          {p.badge}
                        </span>
                      )}
                    </span>
                    <span class="mt-0.5 block text-[0.92rem] leading-snug text-c-muted">{p.why}</span>
                  </span>
                </li>
              ))
            }
          </ul>
          {
            install.permissionsGuide && (
              <a
                href={install.permissionsGuide.href}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-5 inline-flex items-center gap-2 font-display font-semibold text-c-primary underline decoration-2 underline-offset-4"
              >
                {install.permissionsGuide.label}
                <Icon name="arrow" class="h-4 w-4" />
              </a>
            )
          }
        </section>
        )
      }

      <section id="k-panel-faq" role="tabpanel" aria-labelledby="k-tab-faq" data-k-panel="faq" hidden>
        <div class="grid gap-3">
          {
            install.faq.map((f) => (
              <details class:list={['k-details', cardClass]}>
                <summary class="flex items-center justify-between gap-3 px-4 py-3.5 font-display text-lg font-semibold">
                  {f.q}
                  <Icon name="chevron" class="k-chevron h-5 w-5 flex-none" />
                </summary>
                <p class="px-4 pb-4 text-[0.97rem] text-c-muted">{f.a}</p>
              </details>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</dialog>
