---
import Seo from '../../components/seo/Seo.astro';
import type { Lang } from '../../i18n/ui';
import { LANG_REDIRECT } from '../../lib/lang-redirect';
import type { AppMeta, PageMeta, Skin } from '../types';

interface Props {
  app: AppMeta;
  lang: Lang;
  meta: PageMeta;
  skins: Skin[];
  fontDisplay: string;
  fontBody: string;
  jsonLd: Record<string, unknown>;
  defaultScheme?: 'light' | 'dark';
}
const { app, lang, meta, skins, fontDisplay, fontBody, jsonLd, defaultScheme } = Astro.props;
const [first] = skins;

const rule = (skin: Skin) => {
  const keys = Object.keys(skin.light);
  const vars = keys.map((k) => `--c-${k}:light-dark(${skin.light[k]},${skin.dark[k]});`).join('');
  return `${vars}--c-glow:${skin.glow};`;
};
const css =
  `:root{--k-font-display:${fontDisplay};--k-font-body:${fontBody};}` +
  `:root,:root[data-skin="${first.id}"]{${rule(first)}}` +
  skins
    .slice(1)
    .map((s) => `:root[data-skin="${s.id}"]{${rule(s)}}`)
    .join('');

const themeKey = `darmixista:theme:${app.slug}`;
const init = `(function(){var d=document.documentElement,t=null;try{t=localStorage.getItem('${themeKey}')}catch(e){}if(t!=='light'&&t!=='dark')t=${defaultScheme ? `'${defaultScheme}'` : 'null'};if(t)d.dataset.theme=t;d.classList.add('k-js');if(/iPhone|iPad|iPod/.test(navigator.userAgent)||(navigator.platform==='MacIntel'&&navigator.maxTouchPoints>1))d.dataset.ios='';})();`;
---

<!doctype html>
<html
  lang={lang === 'es' ? 'es-MX' : 'en'}
  data-skin={first.id}
  data-theme-key={themeKey}
  data-bg-light={first.light.bg}
  data-bg-dark={first.dark.bg}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={first.light.bg} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={first.dark.bg} media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <Seo
      lang={lang}
      title={meta.title}
      description={meta.description}
      path={`${app.slug}/`}
      image={app.og[lang]}
      imageAlt={meta.ogAlt}
      siteName={app.name}
      jsonLd={jsonLd}
      icons={{ png32: app.icon32, apple: app.apple }}
    />
    <link rel="preconnect" href="https://api.github.com" crossorigin />
    <style is:inline set:html={css}></style>
    <script is:inline set:html={init}></script>
    <script is:inline set:html={LANG_REDIRECT}></script>
  </head>
  <body>
    <slot />
  </body>
</html>
