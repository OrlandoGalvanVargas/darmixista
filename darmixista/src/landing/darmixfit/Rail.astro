---
import Icon from '../kit/Icon.astro';

interface Props {
  labels: string[];
}
const { labels } = Astro.props;
const targets = ['#top', '#how', '#programs', '#get'];
---

<nav class="df-rail fixed top-1/2 right-5 z-30 hidden -translate-y-1/2 xl:grid" aria-label={labels.join(' · ')}>
  {
    labels.map((label, i) => (
      <a href={targets[i]} class="df-rail-item" data-rail-item={i} aria-label={label} title={label}>
        {i < 3 ? <span>{String(i + 1).padStart(2, '0')}</span> : <Icon name="check" class="h-3.5 w-3.5" />}
      </a>
    ))
  }
</nav>

<style>
  .df-rail {
    gap: 0.6rem;
    justify-items: end;
  }
  .df-rail-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    color: var(--c-outline);
    transition: color 0.3s;
  }
  .df-rail-item::after {
    content: '';
    width: 1.4rem;
    height: 4px;
    background: currentColor;
    transition:
      width 0.3s,
      box-shadow 0.3s;
  }
  .df-rail-item.is-done {
    color: var(--c-mid);
  }
  .df-rail-item.is-on {
    color: var(--c-primary);
  }
  .df-rail-item.is-on::after {
    width: 2.2rem;
    background: var(--c-accent);
    box-shadow: 0 0 10px rgb(var(--c-glow) / 0.9);
  }
  .df-rail-item:hover {
    color: var(--c-text);
  }
  @media (max-height: 520px) {
    .df-rail {
      display: none;
    }
  }
</style>

<script>
  const items = [...document.querySelectorAll<HTMLElement>('[data-rail-item]')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-rail]')];
  if (items.length && sections.length) {
    const ratios = new Map<Element, number>();
    const update = () => {
      let best = 0;
      let max = -1;
      sections.forEach((s, i) => {
        const r = ratios.get(s) ?? 0;
        if (r > max) {
          max = r;
          best = i;
        }
      });
      items.forEach((it, i) => {
        it.classList.toggle('is-on', i === best);
        it.classList.toggle('is-done', i < best);
      });
    };
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => ratios.set(e.target, e.intersectionRatio));
        update();
      },
      { threshold: [0, 0.25, 0.5, 0.75, 1] },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
