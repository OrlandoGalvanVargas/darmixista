---
import type { Lang } from '../../i18n/ui';
import Download from '../kit/Download.astro';
import Footer from '../kit/Footer.astro';
import type { AppMeta } from '../types';
import type { DarmixFitContent } from '../../data/landings/darmixfit';
import Reactor from './Reactor.astro';

interface Props {
  app: AppMeta;
  lang: Lang;
  c: DarmixFitContent;
}
const { app, lang, c } = Astro.props;
---

<section id="get" class="df-screen flex-col !pb-0" aria-labelledby="get-title" data-rail="3">
  <div class="k-container relative flex w-full flex-1 flex-col items-center justify-center text-center">
    <div class="relative aspect-square w-[clamp(10rem,35svh,26rem)] [@media(max-height:780px)]:w-[clamp(9rem,30svh,26rem)] max-w-[72vw]" data-reactor-stage>
      <div class="df-glow inset-[-38%] bg-[radial-gradient(circle,rgb(var(--c-glow)/0.38),transparent_60%)]" aria-hidden="true"></div>
      <Reactor uid="final" level={3} of={c.reactor.of} done={c.reactor.done} mode="final" />
    </div>
    <p class="df-kicker mt-[clamp(0.75rem,3vh,1.75rem)]">{c.final.kicker}</p>
    <h2 id="get-title" class="df-display df-h2 mt-2" set:html={c.final.title} />
    <p class="mt-3 max-w-xl text-c-muted sm:text-lg">{c.final.lead}</p>
    <div class="mt-[clamp(1rem,3.5vh,1.75rem)] flex flex-col items-center gap-3">
      <Download app={app} lang={lang} meta class="!items-center" btnClass="df-btn" />
      <button type="button" data-k-sheet-open="install" class="df-link">{c.final.howTo}</button>
    </div>
  </div>
  <div class="k-container relative w-full">
    <Footer app={app} lang={lang} class="border-t border-c-ink" />
  </div>
</section>
