---
interface Props {
  uid: string;
  level: number;
  of: string;
  done: string;
  mode?: 'hero' | 'final';
  class?: string;
}
const { uid, level, of, done, mode, class: className } = Astro.props;

const C = 200;
const pt = (r: number, a: number) => [C + r * Math.cos((a * Math.PI) / 180), C + r * Math.sin((a * Math.PI) / 180)].map((v) => +v.toFixed(2));
const arc = (r1: number, r2: number, a1: number, a2: number) => {
  const [x1, y1] = pt(r2, a1);
  const [x2, y2] = pt(r2, a2);
  const [x3, y3] = pt(r1, a2);
  const [x4, y4] = pt(r1, a1);
  return `M${x1} ${y1}A${r2} ${r2} 0 0 1 ${x2} ${y2}L${x3} ${y3}A${r1} ${r1} 0 0 0 ${x4} ${y4}Z`;
};

const cells = Array.from({ length: 12 }, (_, i) => {
  const a = -90 + i * 30 + 3.5;
  return { cell: arc(140, 180, a, a + 23), streak: arc(158, 162, a + 5, a + 18), block: arc(138, 184, a + 23, a + 30), shine: arc(150, 172, a + 24.5, a + 28.5) };
});
const slots = Array.from({ length: 16 }, (_, i) => {
  const deg = i * 22.5;
  const [x, y] = pt(112, deg - 90);
  return { x, y, deg };
});
const clamps = [210, 330, 90].map((deg) => {
  const [x, y] = pt(118, deg);
  return { x, y, rot: deg + 90 };
});

const lit = (n: number) => Math.round((Math.min(level, 3) / 3) * n);
const fill = level >= 3 ? 1 : 0.08 + (level / 3) * 0.6;
const surface = 286 - 172 * fill;
const shown = Math.max(0, Math.min(3, Math.round(level)));
const wave = `M-200 0 Q-175 -8 -150 0 ${Array.from({ length: 15 }, (_, i) => `T${-100 + i * 50} 0`).join(' ')}`;
const id = (s: string) => `${uid}-${s}`;
---

<svg
  viewBox="0 0 400 400"
  class:list={['df-reactor', { 'is-full': level >= 3 }, className]}
  data-reactor={mode}
  data-level={level}
  style={`--ly:${(surface - 200).toFixed(1)}`}
  aria-hidden="true"
>
  <defs>
    <radialGradient id={id('bz')} cx="50%" cy="40%">
      <stop offset="0" stop-color="#3c3d3f"></stop>
      <stop offset="1" stop-color="#1c1d1f"></stop>
    </radialGradient>
    <linearGradient id={id('on')} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="var(--c-bright)"></stop>
      <stop offset="1" stop-color="var(--c-accent)"></stop>
    </linearGradient>
    <linearGradient id={id('liq')} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="var(--c-bright)"></stop>
      <stop offset=".22" stop-color="var(--c-accent)"></stop>
      <stop offset=".7" stop-color="var(--c-deep)"></stop>
    </linearGradient>
    <radialGradient id={id('vig')}>
      <stop offset=".55" stop-color="#000" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#000" stop-opacity=".6"></stop>
    </radialGradient>
    <pattern id={id('mesh')} width="12" height="10.4" patternUnits="userSpaceOnUse">
      <path d="M0 10.4 6 0l6 10.4zM6 0h12" fill="none" stroke="#2a2d29" stroke-width="1.4"></path>
    </pattern>
    <filter id={id('gl')} x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="5" result="b"></feGaussianBlur>
      <feMerge><feMergeNode in="b"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
    </filter>
    <clipPath id={id('well')}><circle cx="200" cy="200" r="86"></circle></clipPath>
  </defs>

  <circle cx="200" cy="200" r="198" fill="#2b2c2e" stroke="#6e6f71" stroke-width="2"></circle>
  <circle cx="200" cy="200" r="188" fill={`url(#${id('bz')})`} stroke="#111" stroke-width="2"></circle>

  {
    cells.map((c, i) => (
      <g class:list={['df-cell', { on: i < lit(12) }]} data-cell>
        <path class="df-cell-off" d={c.cell} />
        <path class="df-cell-on" d={c.cell} fill={`url(#${id('on')})`} filter={`url(#${id('gl')})`} />
        <path class="df-cell-on" d={c.streak} fill="#fff" opacity=".55" />
        <path d={c.block} fill="#3a3b3d" stroke="#151617" stroke-width="1" />
        <path d={c.shine} fill="#55565a" opacity=".6" />
      </g>
    ))
  }

  <circle cx="200" cy="200" r="134" fill="#1a1b1d" stroke="#4d4e50" stroke-width="3"></circle>
  <circle cx="200" cy="200" r="122" fill="#0c0d0f" stroke="#2c2d2f" stroke-width="2"></circle>

  {
    slots.map((s, i) => (
      <rect
        class:list={['df-slot', { on: i < lit(16) }]}
        data-slot
        x={s.x - 6}
        y={s.y - 4}
        width="12"
        height="8"
        rx="1.5"
        transform={`rotate(${s.deg} ${s.x} ${s.y})`}
      />
    ))
  }

  <circle cx="200" cy="200" r="94" fill="#050605" stroke="#3a3b3d" stroke-width="4"></circle>
  <g clip-path={`url(#${id('well')})`}>
    <rect x="100" y="100" width="200" height="200" fill={`url(#${id('mesh')})`}></rect>
    <g class="df-tilt">
      <g class="df-level">
        <g class="df-wave">
          <path d={`${wave} V150 H-200Z`} fill={`url(#${id('liq')})`} opacity=".92"></path>
          <path d={wave} fill="none" stroke="#fff" stroke-opacity=".7" stroke-width="2"></path>
        </g>
      </g>
    </g>
    <rect class="df-mesh-top" x="100" y="100" width="200" height="200" fill={`url(#${id('mesh')})`}></rect>
    <circle cx="200" cy="200" r="86" fill={`url(#${id('vig')})`}></circle>
  </g>
  <circle class="df-core-ring" cx="200" cy="200" r="88" fill="none" stroke="var(--c-accent)" stroke-width="2" filter={`url(#${id('gl')})`}></circle>

  {
    clamps.map((c) => (
      <g transform={`translate(${c.x.toFixed(2)} ${c.y.toFixed(2)}) rotate(${c.rot})`}>
        <rect x="-17" y="-34" width="34" height="62" rx="4" fill="#1e1f21" stroke="#4d4e50" stroke-width="2" />
        <circle cx="0" cy="10" r="10" fill="#2c2d2f" stroke="#55565a" stroke-width="2" />
        <path d="M-6 4l12 12M6 4l-12 12" stroke="#0b0c0e" stroke-width="2.5" />
      </g>
    ))
  }

  <text class="df-num" x="200" y="214" text-anchor="middle" data-num>{String(shown).padStart(2, '0')}</text>
  <text class="df-sub" x="200" y="244" text-anchor="middle" data-sub data-of={of} data-done={done}>{level >= 3 ? done : of}</text>
</svg>

<style>
  .df-reactor {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.55));
  }
  .df-cell-off {
    fill: color-mix(in srgb, var(--c-dim) 82%, var(--c-mid) 18%);
    stroke: #0b0c0e;
    stroke-width: 1.5;
  }
  .df-cell-on {
    opacity: 0;
    transition: opacity 0.45s ease;
  }
  .df-cell.on .df-cell-on {
    opacity: 1;
  }
  .df-slot {
    fill: #5e5f61;
    opacity: 0.8;
    transition:
      fill 0.4s,
      opacity 0.4s;
  }
  .df-slot.on {
    fill: color-mix(in srgb, var(--c-bright) 35%, #fff);
    opacity: 1;
    filter: drop-shadow(0 0 4px var(--c-accent));
  }
  .df-tilt {
    transform-origin: 200px 200px;
    transform: rotate(var(--tilt, -6deg));
  }
  .df-level {
    transform: translate(0, calc(200px + var(--ly) * 1px));
    transition: transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .df-mesh-top {
    opacity: 0.55;
  }
  .df-core-ring {
    stroke-opacity: 0.25;
    transition: stroke-opacity 0.6s;
  }
  .df-num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 78px;
    fill: #f4f6f1;
    paint-order: stroke;
    stroke: rgb(0 0 0 / 0.55);
    stroke-width: 8px;
  }
  .df-sub {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 3px;
    text-transform: uppercase;
    fill: #f4f6f1;
    paint-order: stroke;
    stroke: rgb(0 0 0 / 0.6);
    stroke-width: 4px;
  }
  .is-full .df-mesh-top {
    opacity: 0.9;
  }
  .is-full .df-core-ring {
    stroke-opacity: 0.9;
  }
  @media (prefers-reduced-motion: no-preference) {
    .df-wave {
      animation: df-wave 3.2s linear infinite;
    }
    .is-full {
      animation: df-pulse 2.8s ease-in-out infinite;
    }
  }
  @keyframes df-wave {
    to {
      transform: translateX(100px);
    }
  }
  @keyframes df-pulse {
    50% {
      filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.55)) drop-shadow(0 0 26px rgb(var(--c-glow) / 0.55));
    }
  }
</style>
