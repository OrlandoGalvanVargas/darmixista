---
import { scene, type DarmixNightContent } from '../../data/landings/darmixnight';

interface Props {
  c: DarmixNightContent;
}
const { c } = Astro.props;
const e = c.emergency;
const start = 5;
const C = 200;
const at = (r: number, deg: number) => [C + r * Math.cos((deg * Math.PI) / 180), C + r * Math.sin((deg * Math.PI) / 180)].map((v) => +v.toFixed(2));
const angle = (v: number) => -225 + v * 9;
const ticks = Array.from({ length: 31 }, (_, i) => {
  const [x1, y1] = at(i % 5 ? 176 : 168, angle(i));
  const [x2, y2] = at(186, angle(i));
  const [tx, ty] = at(152, angle(i));
  return { i, x1, y1, x2, y2, tx, ty: ty + 6 };
});
const arc = (v: number) => {
  const [x1, y1] = at(186, angle(0));
  const [x2, y2] = at(186, angle(v));
  return `M${x1} ${y1}A186 186 0 ${v * 9 > 180 ? 1 : 0} 1 ${x2} ${y2}`;
};
---

<section id="emergency" class="dn-screen" aria-labelledby="emergency-title">
  <div class="dn-glow top-[12%] left-[-6%] h-[40rem] w-[40rem]" aria-hidden="true"></div>
  <div class="dn-emg k-container relative grid w-full items-center gap-5 lg:grid-cols-[auto_1fr] lg:gap-24">
    <div class="dn-knob-wrap mx-auto" data-k-reveal>
      <svg viewBox="0 0 400 400" class="dn-dial" aria-hidden="true">
        <circle cx="200" cy="200" r="190" fill="none" stroke="var(--c-ink)"></circle>
        {
          ticks.map((t) => (
            <line
              x1={t.x1}
              y1={t.y1}
              x2={t.x2}
              y2={t.y2}
              data-tick={t.i}
              class:list={['dn-tick', { on: t.i <= start }]}
              stroke-width={t.i % 5 ? 1.5 : 2.5}
            />
          ))
        }
        {
          ticks
            .filter((t) => t.i % 5 === 0)
            .map((t) => (
              <text x={t.tx} y={t.ty} text-anchor="middle" data-num={t.i} class:list={['dn-num', { on: t.i <= start }]}>
                {t.i}
              </text>
            ))
        }
        <path d={arc(start)} class="dn-arc" data-arc></path>
      </svg>
      <div
        class="dn-knob"
        role="slider"
        tabindex="0"
        aria-label={e.knob}
        aria-valuemin="1"
        aria-valuemax="30"
        aria-valuenow={start}
        aria-valuetext={`${start} ${e.unit}`}
        data-knob
        data-unit={e.unit}
        style={`--rot:${angle(start) + 90}deg`}
      >
        <img src={scene.knob} alt="" width="640" height="640" loading="lazy" draggable="false" />
      </div>
      <p class="dn-knob-value" aria-hidden="true"><span data-knob-value>{start}</span> <span class="dn-em text-[0.5em]">{e.unit}</span></p>
    </div>

    <div class="dn-emg-text">
      <h2 id="emergency-title" class="dn-serif dn-h2" data-k-reveal set:html={e.title} />
      <p class="dn-lead mt-[clamp(0.8rem,2.4vh,1.25rem)] max-w-[30em]" data-k-reveal>{e.lead}</p>
      <ol class="mt-[clamp(1rem,3.5vh,1.75rem)] grid max-w-[30rem] gap-2.5" data-k-reveal>
        {
          e.steps.map((step, i) => (
            <li class="flex items-baseline gap-4 border-b border-c-ink pb-2.5">
              <span class="dn-em min-w-[1.5rem] text-[1.6rem] leading-none">{i + 1}</span>
              <span class="text-[0.98rem] text-c-clay">{step}</span>
            </li>
          ))
        }
      </ol>
      <p class="dn-rule mt-[clamp(1rem,3vh,1.5rem)] max-w-[30rem]" data-k-reveal>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
        <span>{e.rule}</span>
      </p>
    </div>
  </div>
</section>

<style>
  .dn-knob-wrap {
    position: relative;
    width: min(32rem, calc(100svh - 14rem), 86vw);
    aspect-ratio: 1;
    margin-bottom: 2.5rem;
  }
  .dn-dial {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .dn-tick {
    stroke: var(--c-bronze);
    transition: stroke 0.2s;
  }
  .dn-tick.on {
    stroke: var(--c-primary);
  }
  .dn-num {
    font-family: var(--font-display);
    font-size: 18px;
    fill: var(--c-muted);
  }
  .dn-num.on {
    fill: var(--c-amber);
  }
  .dn-arc {
    fill: none;
    stroke: var(--c-primary);
    stroke-width: 3;
    filter: drop-shadow(0 0 6px var(--c-primary));
  }
  .dn-knob {
    position: absolute;
    inset: 14%;
    border-radius: 50%;
    cursor: grab;
    touch-action: none;
    rotate: var(--rot);
    transition: rotate 0.12s ease-out;
  }
  .dn-knob:active {
    cursor: grabbing;
  }
  .dn-knob:focus-visible {
    outline: 2px solid var(--c-amber);
    outline-offset: 6px;
  }
  .dn-knob img {
    width: 100%;
    height: 100%;
    pointer-events: none;
    user-select: none;
    filter: drop-shadow(0 30px 40px #000);
  }
  .dn-knob-value {
    position: absolute;
    left: 50%;
    bottom: -2.25rem;
    translate: -50% 0;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 7vh, 4rem);
    line-height: 1;
    white-space: nowrap;
  }
  @media (max-width: 639px) {
    .dn-rule {
      padding: 0.75rem 0.9rem;
      font-size: 0.85rem;
    }
  }
  .dn-rule {
    display: flex;
    gap: 0.75rem;
    padding: 0.9rem 1.1rem;
    border-radius: 1rem;
    background: var(--c-surface);
    box-shadow: inset 0 0 0 1px var(--c-ink);
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--c-text);
  }
  .dn-rule svg {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.15rem;
    color: var(--c-amber);
  }
  @media (max-width: 1023px) {
    .dn-knob-wrap {
      width: min(46vw, 15rem);
      margin: 0 auto 2.5rem;
    }
    .dn-knob-value {
      bottom: -2.4rem;
      font-size: 2.4rem;
    }
  }
  @media (max-width: 767px) {
    .dn-emg {
      grid-template-columns: auto 1fr;
      column-gap: 1.25rem;
      row-gap: 0;
    }
    .dn-emg-text {
      display: contents;
    }
    .dn-knob-wrap {
      grid-row: 1;
      grid-column: 1;
      width: clamp(7.5rem, 34vw, 10rem);
      margin: 0 0 2.5rem;
    }
    .dn-emg-text > :global(h2) {
      grid-row: 1;
      grid-column: 2;
      font-size: clamp(2.1rem, 9vw, 2.75rem);
      margin-bottom: 2.5rem;
    }
    .dn-emg-text > :not(h2) {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  const knob = document.querySelector<HTMLElement>('[data-knob]');
  if (knob) {
    const value = document.querySelector('[data-knob-value]');
    const arc = document.querySelector<SVGPathElement>('[data-arc]');
    const ticks = [...document.querySelectorAll<SVGLineElement>('[data-tick]')];
    const nums = [...document.querySelectorAll<SVGTextElement>('[data-num]')];
    const unit = knob.dataset.unit ?? '';
    const angle = (v: number) => -225 + v * 9;
    let current = Number(knob.getAttribute('aria-valuenow'));

    const set = (v: number) => {
      const next = Math.max(1, Math.min(30, Math.round(v)));
      if (next === current) return;
      current = next;
      knob.style.setProperty('--rot', `${angle(next) + 90}deg`);
      knob.setAttribute('aria-valuenow', String(next));
      knob.setAttribute('aria-valuetext', `${next} ${unit}`);
      if (value) value.textContent = String(next);
      ticks.forEach((t) => t.classList.toggle('on', Number(t.dataset.tick) <= next));
      nums.forEach((n) => n.classList.toggle('on', Number(n.dataset.num) <= next));
      if (arc) {
        const r = 186;
        const p = (d: number) => [200 + r * Math.cos((d * Math.PI) / 180), 200 + r * Math.sin((d * Math.PI) / 180)].map((x) => x.toFixed(2));
        const [x1, y1] = p(angle(0));
        const [x2, y2] = p(angle(next));
        arc.setAttribute('d', `M${x1} ${y1}A${r} ${r} 0 ${next * 9 > 180 ? 1 : 0} 1 ${x2} ${y2}`);
      }
      if (navigator.vibrate) navigator.vibrate(4);
    };

    const fromPointer = (e: PointerEvent) => {
      const r = knob.getBoundingClientRect();
      const deg = (Math.atan2(e.clientY - (r.top + r.height / 2), e.clientX - (r.left + r.width / 2)) * 180) / Math.PI;
      let t = deg + 225;
      while (t < 0) t += 360;
      while (t >= 360) t -= 360;
      if (t > 270) t = t < 315 ? 270 : 0;
      set(t / 9);
    };

    knob.addEventListener('pointerdown', (e) => {
      knob.setPointerCapture(e.pointerId);
      fromPointer(e);
    });
    knob.addEventListener('pointermove', (e) => {
      if (knob.hasPointerCapture(e.pointerId)) fromPointer(e);
    });
    knob.addEventListener('keydown', (e) => {
      const map: Record<string, number> = { ArrowRight: 1, ArrowUp: 1, ArrowLeft: -1, ArrowDown: -1, PageUp: 5, PageDown: -5 };
      if (e.key === 'Home') set(1);
      else if (e.key === 'End') set(30);
      else if (map[e.key]) set(current + map[e.key]);
      else return;
      e.preventDefault();
    });
  }
</script>
