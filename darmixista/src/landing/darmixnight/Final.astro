---
import type { Lang } from '../../i18n/ui';
import Download from '../kit/Download.astro';
import Footer from '../kit/Footer.astro';
import type { AppMeta } from '../types';
import { scene, type DarmixNightContent } from '../../data/landings/darmixnight';

interface Props {
  app: AppMeta;
  lang: Lang;
  c: DarmixNightContent;
}
const { app, lang, c } = Astro.props;
---

<section id="get" class="dn-screen dn-final flex-col !pb-0" aria-labelledby="get-title">
  <div class="dn-window" aria-hidden="true" style={`--img:url(${scene.window})`}></div>
  <div class="k-container relative flex w-full flex-1 flex-col items-center justify-end pb-[clamp(2rem,7vh,5rem)] text-center">
    <h2 id="get-title" class="dn-serif text-[clamp(4rem,min(10vw,17vh),9.5rem)] leading-[0.9]" data-k-reveal set:html={c.final.title} />
    <p class="dn-lead mt-4 max-w-xl" data-k-reveal>{c.final.lead}</p>
    <div class="mt-[clamp(1.25rem,4vh,2rem)] flex flex-col items-center gap-3" data-k-reveal>
      <Download app={app} lang={lang} meta class="!items-center" btnClass="dn-btn" />
      <button type="button" data-k-sheet-open="install" class="dn-link">{c.final.howTo}</button>
    </div>
  </div>
  <div class="k-container relative w-full">
    <Footer app={app} lang={lang} class="border-t border-c-ink" />
  </div>
</section>

<style>
  .dn-window {
    position: absolute;
    inset: 0;
    background: var(--img) center top / auto 82% no-repeat;
    opacity: 0.8;
  }
  .dn-window::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 60% at 50% 35%, transparent, var(--c-bg) 92%),
      linear-gradient(0deg, var(--c-bg) 12%, transparent 65%);
  }
  @media (max-width: 767px) {
    .dn-window {
      background-size: auto 62%;
    }
  }
</style>
