---
import { scene, type DarmixNightContent } from '../../data/landings/darmixnight';

interface Props {
  c: DarmixNightContent;
}
const { c } = Astro.props;
const h = c.how;
---

<section id="how" class="dn-screen" aria-labelledby="how-title">
  <div class="dn-glow top-[10%] right-[0%] h-[46rem] w-[46rem]" aria-hidden="true"></div>
  <div class="k-container relative grid w-full items-center gap-8 lg:grid-cols-[1fr_auto] lg:gap-20">
    <div>
      <p class="dn-kicker" data-k-reveal>{h.kicker}</p>
      <p class="dn-time mt-[clamp(1rem,3vh,1.75rem)]" data-k-reveal aria-hidden="true">
        <span data-clock>12:54</span><span class="dn-em dn-ampm" data-clock-ampm>am</span>
      </p>
      <h2 id="how-title" class="dn-serif mt-[clamp(1rem,3vh,1.75rem)] text-[clamp(2.2rem,min(3.8vw,7vh),3.5rem)]" data-k-reveal set:html={h.title} />
      <p class="dn-lead mt-3 max-w-[32em]" data-k-reveal>{h.lead}</p>
      <ul class="mt-5 flex flex-wrap gap-2" data-k-reveal>
        {
          h.allowed.map((item) => (
            <li class="rounded-full px-3.5 py-1.5 text-[0.82rem] text-c-clay shadow-[inset_0_0_0_1px_var(--c-ink)]">
              <span class="mr-1.5 text-c-primary" aria-hidden="true">✓</span>
              {item}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="dn-phone mx-auto hidden sm:block" data-k-reveal>
      <img src={scene.lock} alt={h.lockAlt} width="540" height="1014" loading="lazy" />
    </div>
  </div>
</section>

<style>
  .dn-time {
    font-family: var(--font-display);
    font-size: clamp(6.5rem, min(16vw, 24vh), 15rem);
    line-height: 0.8;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .dn-ampm {
    font-size: 0.32em;
    margin-left: 0.3em;
    letter-spacing: 0;
  }
  .dn-phone {
    width: min(19rem, calc((100svh - 10rem) * 0.53));
    aspect-ratio: 540 / 1014;
    padding: 3%;
    border-radius: 14% / 7.4%;
    background: linear-gradient(160deg, #2a1810, #090403 45%, #2a1810);
    box-shadow:
      0 0 0 1px #3a2418,
      0 40px 90px -30px #000,
      0 0 120px -40px rgb(var(--c-glow) / 0.55);
  }
  .dn-phone img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 11% / 5.9%;
  }
  @media (max-width: 1023px) {
    .dn-phone {
      width: min(40vw, calc((100svh - 30rem) * 0.53), 15rem);
      min-width: 8rem;
    }
  }
</style>

<script>
  const time = document.querySelector('[data-clock]');
  const ampm = document.querySelector('[data-clock-ampm]');
  if (time && ampm) {
    const tick = () => {
      const d = new Date();
      const h = d.getHours();
      time.textContent = `${h % 12 || 12}:${String(d.getMinutes()).padStart(2, '0')}`;
      ampm.textContent = h < 12 ? 'am' : 'pm';
    };
    tick();
    setInterval(tick, 15000);
  }
</script>
