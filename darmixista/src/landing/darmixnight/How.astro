---
import { scene, type DarmixNightContent } from '../../data/landings/darmixnight';

interface Props {
  c: DarmixNightContent;
}
const { c } = Astro.props;
const h = c.how;
---

<section id="how" class="dn-screen" aria-labelledby="how-title">
  <div class="dn-glow top-[10%] right-[0%] h-[46rem] w-[46rem]" aria-hidden="true"></div>
  <div class="k-container relative grid w-full items-center gap-8 lg:grid-cols-[1fr_auto] lg:gap-20">
    <div>
      <h2 id="how-title" class="dn-serif dn-h2" data-k-reveal set:html={h.title} />

      <div class="mt-[clamp(1.25rem,4vh,2.25rem)] flex items-end gap-[clamp(1rem,3vw,2.5rem)]" data-k-reveal>
        <p class="dn-slot">
          <span class="dn-slot-label">{h.sleep.label}</span>
          <span class="dn-slot-time">{h.sleep.time}<span class="dn-em dn-slot-ampm">{h.sleep.ampm}</span></span>
        </p>
        <span class="dn-slot-line" aria-hidden="true"></span>
        <p class="dn-slot">
          <span class="dn-slot-label">{h.wake.label}</span>
          <span class="dn-slot-time">{h.wake.time}<span class="dn-em dn-slot-ampm">{h.wake.ampm}</span></span>
        </p>
      </div>
      <p class="mt-3 text-[0.85rem] text-c-muted" data-k-reveal>{h.example}</p>

      <dl class="mt-[clamp(1.25rem,4vh,2.25rem)] grid max-w-[34rem]" data-k-reveal>
        {
          h.moments.map((m, i) => (
            <div class:list={['dn-moment', { 'is-key': i === 1 }]}>
              <dt class="dn-em text-[1.45rem] leading-none sm:text-[1.6rem]">{m.when}</dt>
              <dd class="text-[0.95rem] leading-snug text-c-clay">{m.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="dn-phone mx-auto hidden sm:block" data-k-reveal>
      <img src={scene.lock} alt={h.lockAlt} width="540" height="1014" loading="lazy" />
    </div>
  </div>
</section>

<style>
  .dn-slot {
    display: grid;
    gap: 0.35rem;
  }
  .dn-slot-label {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-clay);
  }
  .dn-slot-time {
    font-family: var(--font-display);
    font-size: clamp(3.4rem, min(7vw, 12vh), 6.25rem);
    line-height: 0.85;
    letter-spacing: -0.02em;
  }
  .dn-slot-ampm {
    font-size: 0.4em;
    margin-left: 0.15em;
    letter-spacing: 0;
  }
  .dn-slot-line {
    flex: 1;
    max-width: 7rem;
    min-width: 1.5rem;
    height: 1px;
    margin-bottom: 1.4rem;
    background: linear-gradient(90deg, var(--c-primary), var(--c-bronze));
  }
  .dn-moment {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    align-items: baseline;
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--c-ink);
  }
  .dn-moment:first-child {
    border-top: 1px solid var(--c-ink);
  }
  .dn-moment.is-key dd {
    color: var(--c-text);
  }
  .dn-phone {
    width: min(19rem, calc((100svh - 10rem) * 0.53));
    aspect-ratio: 540 / 1014;
    padding: 3%;
    border-radius: 14% / 7.4%;
    background: linear-gradient(160deg, #2a1810, #090403 45%, #2a1810);
    box-shadow:
      0 0 0 1px #3a2418,
      0 40px 90px -30px #000,
      0 0 120px -40px rgb(var(--c-glow) / 0.55);
  }
  .dn-phone img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 11% / 5.9%;
  }
  @media (max-width: 1023px) {
    .dn-phone {
      display: none;
    }
  }
  @media (max-width: 639px) {
    .dn-moment {
      grid-template-columns: 4.6rem 1fr;
      gap: 0.75rem;
      padding: 0.65rem 0;
    }
  }
</style>
