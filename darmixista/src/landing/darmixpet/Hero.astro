---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import type { Lang } from '../../i18n/ui';
import Download from '../kit/Download.astro';
import Qr from '../kit/Qr.astro';
import { kitUi } from '../i18n';
import type { AppMeta, Skin } from '../types';
import type { DarmixPetContent } from '../../data/landings/darmixpet';

interface Props {
  app: AppMeta;
  lang: Lang;
  c: DarmixPetContent;
  skin: Skin;
}
const { app, lang, c, skin } = Astro.props;
const ui = kitUi[lang];
const first = c.companions.characters[0];
---

<section id="top" class="pt-screen pt-hero pt-dots relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_bottom,transparent_75%,var(--c-bg))]"
    aria-hidden="true"
  >
  </div>
  <div class="k-container relative grid w-full items-center gap-4 lg:grid-cols-12 lg:gap-6">
    <div class="lg:col-span-7 lg:flex lg:flex-col lg:self-stretch lg:pt-[2.5%]">
      <h1
        class="text-[clamp(2.4rem,min(5.2vw,9.4vh),4.6rem)] font-bold tracking-[-0.015em] [&_em]:text-c-primary [&_em]:not-italic"
        set:html={c.hero.title}
      />
      <p class="mt-[clamp(0.75rem,2.4vh,1.5rem)] max-w-lg text-[clamp(1.05rem,min(1.5vw,2.4vh),1.3rem)] text-c-muted lg:max-w-xl">{c.hero.lead}</p>
      <div class="mt-[clamp(1.5rem,4.5vh,2.75rem)] flex flex-col items-start gap-3">
        <Download app={app} lang={lang} meta btnClass="pt-btn pt-btn-primary" />
        <button
          type="button"
          data-k-sheet-open="install"
          class="pl-1 font-display font-semibold text-c-primary underline decoration-2 underline-offset-4 hover:decoration-[3px]"
        >
          {c.hero.howTo}
        </button>
      </div>
      <p class="pt-ios mt-3 hidden text-sm font-semibold text-c-blocked">{ui.androidOnly}</p>
      <Qr url={getAbsoluteLocaleUrl(lang, `${app.slug}/`)} lang={lang} color={skin.light.ink} class="pt-qr mt-[clamp(1.25rem,5vh,3rem)] max-w-sm lg:mt-auto" />
    </div>

    <div class="relative flex justify-center lg:col-span-5">
      <div class="pt-stage w-[min(76vw,max(10rem,35svh))] flex-none max-md:[@media(max-height:760px)]:w-[min(72vw,max(10rem,29svh))] md:w-[min(60vw,44svh)] lg:w-[min(52rem,74svh,46vw)]">
        <span class="pt-halo pt-halo-wide" aria-hidden="true"></span>
        <span class="pt-ring" aria-hidden="true"></span>
        <span class="pt-ring pt-ring-2" aria-hidden="true"></span>
        <img
          src={skin.image}
          alt={first.name}
          width="445"
          height="720"
          fetchpriority="high"
          data-skin-img
          class="pt-hero-img relative z-[1] h-auto w-[52%]"
        />
      </div>
    </div>
  </div>
</section>

<style>
  :global(html[data-ios]) .pt-ios {
    display: block;
  }
  .pt-hero-img {
    filter: drop-shadow(0 22px 30px rgb(var(--c-glow) / 0.4));
  }
  @media (prefers-reduced-motion: no-preference) {
    .pt-hero-img {
      animation:
        pt-appear 1.1s var(--ease-pop) 0.15s both,
        pt-float 5s ease-in-out 1.3s infinite;
    }
  }
  .pt-hero {
    align-items: flex-start;
    padding-top: clamp(1.5rem, 5vh, 3rem);
    padding-bottom: clamp(1rem, 3vh, 2rem);
  }
  @media (min-width: 768px) {
    .pt-hero {
      align-items: center;
    }
  }
  @media (min-width: 1024px) {
    .pt-hero {
      padding-top: clamp(1rem, 3vh, 2rem);
      padding-bottom: clamp(1.5rem, 6vh, 4rem);
    }
  }
  :global(.pt-halo-wide) {
    inset: -16%;
    background: radial-gradient(circle at 50% 52%, rgb(var(--c-glow) / 0.3), rgb(var(--c-glow) / 0.08) 45%, transparent 68%);
  }
</style>
