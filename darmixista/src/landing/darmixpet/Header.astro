---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Icon from '../kit/Icon.astro';
import { languages, type Lang } from '../../i18n/ui';
import Download from '../kit/Download.astro';
import { kitUi } from '../i18n';
import type { AppMeta } from '../types';

interface Props {
  app: AppMeta;
  lang: Lang;
  nav: { how: string; companions: string; help: string };
}
const { app, lang, nav } = Astro.props;
const ui = kitUi[lang];
---

<header
  class="sticky top-0 z-40 border-b-2 border-transparent bg-c-bg/85 backdrop-blur-md transition-[border-color] duration-300 data-[scrolled]:border-c-outline"
  data-k-header
>
  <div class="k-container flex h-[4.25rem] items-center justify-between gap-2 sm:gap-4">
    <a href="#top" class="flex min-w-0 items-center gap-2.5 font-display text-xl font-bold tracking-tight whitespace-nowrap" aria-label={app.name}>
      <img src={app.icon} alt="" width="40" height="40" class="h-10 w-10 flex-none rounded-xl border-2 border-c-ink" />
      <span class="max-[359px]:sr-only">{app.name}</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label={app.name}>
      <a href="#how" class="rounded-full px-3.5 py-2 font-display font-medium text-c-muted transition-colors hover:bg-c-surface-variant hover:text-c-text">{nav.how}</a>
      <a href="#companions" class="rounded-full px-3.5 py-2 font-display font-medium text-c-muted transition-colors hover:bg-c-surface-variant hover:text-c-text">{nav.companions}</a>
    </nav>

    <div class="flex flex-none items-center gap-1.5 sm:gap-2">
      <div class="flex items-center rounded-full border-2 border-c-ink bg-c-surface p-0.5 font-display text-sm font-semibold" role="group" aria-label={ui.language}>
        {
          (Object.keys(languages) as Lang[]).map((code) => (
            <a
              href={getRelativeLocaleUrl(code, `${app.slug}/`)}
              hreflang={code}
              lang={code}
              data-k-lang={code}
              aria-current={code === lang ? 'true' : undefined}
              class:list={[
                'rounded-full px-2.5 py-1 uppercase transition-colors',
                code === lang ? 'bg-c-primary text-c-on-primary' : 'text-c-muted hover:text-c-text',
              ]}
            >
              {code}
            </a>
          ))
        }
      </div>
      <button type="button" class="pt-icon-btn font-display text-lg font-bold" data-k-sheet-open="install" aria-label={nav.help} title={nav.help}>?</button>
      <button type="button" class="pt-icon-btn" data-k-theme aria-label={ui.theme} title={ui.theme}>
        <Icon name="sun" class="k-theme-light" />
        <Icon name="moon" class="k-theme-dark" />
      </button>
      <Download app={app} lang={lang} class="hidden md:flex" btnClass="k-btn-sm pt-btn pt-btn-primary" />
    </div>
  </div>
</header>
