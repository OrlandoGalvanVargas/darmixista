---
import { SITE } from '../../config/site';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="stage-section" data-section data-nav="about" data-rings="background" aria-labelledby="about-title">
  <div class="section-body" data-section-body>
    <div class="mx-auto flex h-full max-w-[1280px] flex-col items-center justify-center px-6 pt-[4.75rem] pb-14 md:px-12 md:pt-[5.25rem] lg:px-20">
      <div class="grid w-full grid-cols-1 items-center gap-[clamp(0.75rem,2.6vh,1.75rem)] lg:grid-cols-12 lg:gap-16">
        <div data-reveal class="about-photo mx-auto lg:col-span-5 lg:mx-0">
          <img src={SITE.person.photo} alt={t.about.photoAlt} width="820" height="741" loading="lazy" decoding="async" />
        </div>
        <div class="about-copy relative mx-auto max-w-[42rem] text-center lg:col-span-7 lg:mx-0 lg:max-w-none lg:text-left">
          <h2
            id="about-title"
            data-reveal
            class="text-[clamp(1.9rem,min(4.2vw,8vh),3.6rem)] leading-[1.05] font-semibold tracking-[-0.035em]"
          >
            {t.about.title}
          </h2>
          <p data-reveal class="about-lead-long mt-[clamp(1rem,3.2vh,1.75rem)] text-[clamp(0.95rem,2.2vh,1.22rem)] leading-relaxed text-muted">
            {t.about.lead}
          </p>
          <p data-reveal class="about-lead-short mt-[clamp(1rem,3.2vh,1.75rem)] text-[clamp(0.95rem,2.2vh,1.22rem)] leading-relaxed text-muted">
            {t.about.leadShort}
          </p>
          <p data-reveal class="about-long mt-[clamp(0.75rem,2.4vh,1.25rem)] text-[clamp(0.95rem,2.2vh,1.22rem)] leading-relaxed text-muted">
            {t.about.body}
          </p>
          <p data-reveal class="about-short mt-[clamp(0.75rem,2.4vh,1.25rem)] text-[clamp(0.95rem,2.2vh,1.22rem)] leading-relaxed text-muted">
            {t.about.bodyShort}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-photo {
    position: relative;
    height: clamp(7rem, 20vh, 11rem);
    margin-bottom: 0.5rem;
    aspect-ratio: 820 / 741;
  }
  .about-photo::before {
    content: '';
    position: absolute;
    inset: -14% -26% -10%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(8 10 9 / 0.95) 40%, rgb(8 10 9 / 0.6) 70%, transparent 100%);
    pointer-events: none;
  }
  .about-photo::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 4%;
    width: 70%;
    aspect-ratio: 1;
    transform: translateX(-50%);
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--color-accent) 12%, transparent), transparent);
    pointer-events: none;
  }
  .about-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    -webkit-mask-image:
      radial-gradient(ellipse 85% 115% at 50% 25%, #000 62%, transparent 98%),
      linear-gradient(180deg, #000 70%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      radial-gradient(ellipse 85% 115% at 50% 25%, #000 62%, transparent 98%),
      linear-gradient(180deg, #000 70%, transparent 100%);
    mask-composite: intersect;
  }
  .about-copy::before {
    content: '';
    position: absolute;
    inset: -14% -10%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(8 10 9 / 0.88) 50%, rgb(8 10 9 / 0.6) 75%, transparent);
    pointer-events: none;
  }
  @media (min-width: 1024px) {
    .about-photo {
      margin-bottom: 0;
      height: min(58vh, 34rem);
      width: auto;
      justify-self: center;
    }
  }
  @media (min-width: 1024px) and (max-height: 700px) {
    .about-photo {
      height: 54vh;
    }
  }
  @media (max-width: 1023px) and (min-height: 800px) {
    .about-photo {
      height: clamp(9rem, 22vh, 15rem);
    }
  }
  .about-short,
  .about-lead-short {
    display: none;
  }
  @media (max-width: 767px), (min-width: 768px) and (max-height: 620px) {
    .about-long,
    .about-lead-long {
      display: none;
    }
    .about-short,
    .about-lead-short {
      display: block;
    }
  }
  @media (max-width: 767px) and (max-height: 620px) {
    .about-short {
      display: none;
    }
    .about-photo {
      height: 6rem;
    }
  }
</style>
