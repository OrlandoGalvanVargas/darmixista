---
import { SITE } from '../../config/site';
import { useTranslations, type Lang } from '../../i18n/ui';
import HeroName from './HeroName.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const seal = t.hero.seal.toUpperCase();
const arrow = 'M5 12h14M13 6l6 6-6 6';
const arrowUp = 'M7 17 17 7M9 7h8v8';
---

<section id="home" class="stage-section" data-section data-nav="home" data-rings="hero" aria-labelledby="home-title">
  <div class="hero-frame" data-section-body>
    <div class="hero-geo">
      <h1 id="home-title" class="sr-only">{SITE.person.firstName} {SITE.person.lastName} — {t.hero.role}</h1>

      <p class="hero-hello" data-hero-hello aria-hidden="true">
        {
          t.hero.hello.split(' ').map((word) => (
            <span class="hhw">
              {[...word].map((c) => (
                <span class="hhc">{c}</span>
              ))}
            </span>
          ))
        }
      </p>

      <div class="hero-outline" aria-hidden="true">
        <HeroName variant="outline" />
      </div>

      <p class="hero-role" data-hero-role aria-hidden="true">{t.hero.role}</p>

      <a href="#projects" data-goto="projects" class="hero-cta hero-cta-projects" data-hero-cta>
        <span class="hero-cta-dot" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d={arrow} /></svg>
          <svg viewBox="0 0 24 24" fill="none"><path d={arrow} /></svg>
        </span>
        <span class="hero-cta-body">
          <span class="hero-cta-kicker" aria-hidden="true">{t.hero.projectsKicker}</span>
          <span class="hero-cta-label">{t.hero.ctaProjects}</span>
          <span class="hero-cta-bar" aria-hidden="true"><i></i></span>
        </span>
      </a>

      <a href="#contact" data-goto="contact" class="hero-cta hero-cta-contact" data-hero-cta>
        <span class="hero-cta-dot" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d={arrowUp} /></svg>
          <svg viewBox="0 0 24 24" fill="none"><path d={arrowUp} /></svg>
        </span>
        <span class="hero-cta-body">
          <span class="hero-cta-kicker" aria-hidden="true">{t.hero.contactKicker}</span>
          <span class="hero-cta-label">{t.hero.ctaContact}</span>
          <span class="hero-cta-bar" aria-hidden="true"><i></i></span>
        </span>
      </a>

      <a href="#projects" data-goto="projects" class="hero-seal" data-hero-seal aria-label={t.hero.next}>
        <svg class="hero-seal-ring" viewBox="0 0 100 100" aria-hidden="true">
          <defs>
            <path id="hero-seal-path" d="M50 50m-31 0a31 31 0 1 1 62 0a31 31 0 1 1-62 0" />
          </defs>
          <text text-anchor="middle">
            <textPath href="#hero-seal-path" startOffset="25%" textLength="70" lengthAdjust="spacing">{seal}</textPath>
          </text>
          <text text-anchor="middle">
            <textPath href="#hero-seal-path" startOffset="75%" textLength="70" lengthAdjust="spacing">{seal}</textPath>
          </text>
          <circle cx="15.8" cy="50" r="1.15" />
          <circle cx="84.2" cy="50" r="1.15" />
        </svg>
        <span class="hero-seal-core" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
        </span>
      </a>

      <a href="#projects" data-goto="projects" class="hero-scroll" data-hero-scroll aria-label={t.hero.next}>
        <span class="hero-mouse" aria-hidden="true"><i></i></span>
        <span class="hero-chevrons" aria-hidden="true">
          <svg viewBox="0 0 24 14" fill="none"><path d="m6 3 6 6 6-6" /></svg>
          <svg viewBox="0 0 24 14" fill="none"><path d="m6 3 6 6 6-6" /></svg>
        </span>
      </a>
    </div>
  </div>
</section>
