---
import { SITE } from '../../config/site';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!--
  data-rings="hero": los anillos se colocan a la derecha (abajo en móvil).
  Los tamaños y espacios usan min(vw, vh) para que todo quepa en una sola pantalla, sin desplazamiento.
-->
<section id="home" class="stage-section" data-section data-nav="home" data-rings="hero" aria-labelledby="home-title">
  <div class="section-body" data-section-body>
    <div
      class="mx-auto grid h-full max-w-[1400px] grid-cols-1 content-start px-6 pt-[max(5.5rem,13vh)] md:grid-cols-12 md:content-center md:px-12 md:pt-16 lg:px-20"
    >
      <div data-hero-content class="flex flex-col items-center text-center md:col-span-7 md:items-start md:text-left lg:col-span-6">
        <h1
          id="home-title"
          data-reveal
          class="text-[clamp(2.2rem,min(5.2vw,9.5vh),5.25rem)] leading-[0.95] font-semibold tracking-[-0.035em] uppercase"
        >
          <span class="block">{SITE.person.firstName}</span>
          <span class="block text-fg/90">{SITE.person.lastName}</span>
        </h1>

        <p
          data-reveal
          class="mt-[clamp(0.5rem,2vh,1.25rem)] text-[clamp(1rem,min(1.7vw,3vh),1.6rem)] font-light tracking-tight text-accent"
        >
          {t.hero.role}
        </p>

        <p
          data-reveal
          class="mt-[clamp(0.75rem,2.6vh,1.5rem)] max-w-[34rem] text-[clamp(0.875rem,2vh,1rem)] leading-relaxed text-muted"
        >
          {t.hero.bio}
        </p>

        <div
          data-reveal
          class="mt-[clamp(1.25rem,4.5vh,2.5rem)] flex w-full flex-col gap-3 sm:w-auto sm:flex-row"
        >
          <a href="#projects" data-goto="projects" class="btn btn-primary">
            {t.hero.ctaProjects}
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
          <a href="#contact" data-goto="contact" class="btn btn-ghost">{t.hero.ctaContact}</a>
        </div>

        <a
          data-reveal
          href={SITE.cv[lang]}
          download
          class="link-subtle mt-[clamp(1rem,3vh,1.75rem)] font-mono text-xs tracking-[0.12em]"
        >
          {t.hero.cv} <span class="text-accent" aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </div>
</section>
