---
import { SITE } from '../../config/site';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const accentWords = new Set(t.hero.roleAccent.map((w) => w.toLowerCase()));
const roleParts = t.hero.role.split(/(\s+)/).map((word) => ({ word, accent: accentWords.has(word.toLowerCase()) }));
---
<section id="home" class="stage-section" data-section data-nav="home" data-rings="hero" aria-labelledby="home-title">
  <div class="section-body" data-section-body>
    <div
      class="mx-auto grid h-full max-w-[1400px] grid-cols-1 content-start px-6 pt-[max(5.5rem,13vh)] md:grid-cols-12 md:content-center md:px-12 md:pt-16 md:pb-[6vh] lg:px-20"
    >
      <div data-hero-content class="flex flex-col items-center text-center md:col-span-7 md:items-start md:text-left lg:col-span-6">
        <h1
          id="home-title"
          data-reveal
          class="text-[clamp(2.2rem,min(5.2vw,9.5vh),5.25rem)] leading-[0.98] font-semibold tracking-[-0.03em] uppercase"
        >
          <span class="hero-title-line block whitespace-nowrap">{SITE.person.firstName}</span>
          <span class="hero-title-line block whitespace-nowrap">{SITE.person.lastName}</span>
        </h1>

        <p
          data-reveal
          class="mt-[clamp(0.5rem,1.8vh,1rem)] text-[clamp(1.05rem,min(1.8vw,3.2vh),1.75rem)] font-normal tracking-tight text-fg/90"
        >
          {roleParts.map((p) => (p.accent ? <span class="text-accent-hi">{p.word}</span> : p.word))}
        </p>


        <p
          data-reveal
          class="hero-bio-long mt-[clamp(0.9rem,2.6vh,1.6rem)] max-w-[34rem] text-[clamp(0.95rem,2.3vh,1.15rem)] leading-relaxed text-muted"
        >
          {t.hero.bio}
        </p>
        <p
          data-reveal
          class="hero-bio-short mt-[clamp(0.9rem,2.6vh,1.6rem)] max-w-[30rem] text-[clamp(0.92rem,2.1vh,1.05rem)] leading-relaxed text-muted"
        >
          {t.hero.bioShort}
        </p>

        <div
          data-reveal
          class="hero-ctas mt-[clamp(1.25rem,4.5vh,2.5rem)] flex w-full flex-col gap-3 sm:w-auto sm:flex-row"
        >
          <a href="#projects" data-goto="projects" class="btn btn-primary">
            {t.hero.ctaProjects}
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
          <a href="#contact" data-goto="contact" class="btn btn-ghost">{t.hero.ctaContact}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @media (min-width: 350px) and (max-width: 639px) {
    .hero-ctas {
      flex-direction: row;
      justify-content: center;
    }
    .hero-ctas .btn {
      flex: 1 1 0;
      padding-inline: 1rem;
    }
  }

  .hero-bio-short {
    display: none;
  }
  @media (max-height: 620px) {
    .hero-bio-long {
      display: none;
    }
    .hero-bio-short {
      display: block;
    }
  }
</style>
