---
/**
 * Servicios. Escritorio: encabezado + cuadrícula 3×2 de tarjetas de "cristal" con brillo que
 * sigue al cursor. Teléfono: filas compactas (ícono + título + una línea).
 * El cristal es simulado (transparencias y reflejos) sin backdrop-filter, para no recalcular
 * un desenfoque sobre los anillos en cada frame.
 */
import ServiceIcon from '../services/ServiceIcon.astro';
import { SERVICES } from '../../data/services';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang).services;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="services" class="stage-section" data-section data-nav="services" data-rings="background" aria-labelledby="services-title">
  <div class="section-body" data-section-body>
    <div
      class="mx-auto flex h-full max-w-[1400px] flex-col justify-center px-6 pt-[4.5rem] pb-12 md:px-12 md:pt-[5.25rem] md:pb-16 lg:px-20"
    >
      <header class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between md:gap-10">
        <div class="max-md:text-center">
          <h2
            id="services-title"
            data-reveal
            class="text-[clamp(1.9rem,min(4vw,7vh),3.5rem)] leading-none font-semibold tracking-[-0.035em]"
          >
            {t.title}
          </h2>
          <p data-reveal class="svc-intro mt-[clamp(0.6rem,1.8vh,1.1rem)] max-w-[34rem] text-[clamp(0.88rem,2.1vh,1.05rem)] leading-relaxed text-muted">
            {t.intro}
          </p>
        </div>
        <a data-reveal href="#contact" data-goto="contact" class="btn btn-primary flex-none max-md:hidden">
          {t.cta}
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      </header>

      <ul class="svc-grid mt-[clamp(1rem,4vh,2.75rem)]" data-svc-grid>
        {
          SERVICES.map((s, i) => (
            <li data-reveal class="svc-card">
              <span class="svc-glow" aria-hidden="true" />
              <div class="svc-top">
                <ServiceIcon name={s.icon} class="svc-ico" />
                <span class="svc-num">{pad(i + 1)}</span>
              </div>
              <div class="svc-text">
                <h3 class="svc-title">{s.title[lang]}</h3>
                <p class="svc-desc">{s.description[lang]}</p>
                <p class="svc-short">{s.short[lang]}</p>
              </div>
              <span class="svc-arrow" aria-hidden="true">→</span>
            </li>
          ))
        }
      </ul>

      <a data-reveal href="#contact" data-goto="contact" class="btn btn-primary mt-[clamp(1rem,3vh,1.75rem)] w-full md:hidden">
        {t.cta}
        <span class="btn-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<script>
  // Brillo que sigue al cursor dentro de cada tarjeta (solo con mouse; un rAF por movimiento)
  const grid = document.querySelector<HTMLElement>('[data-svc-grid]');
  if (grid && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let frame = 0;
    let last: PointerEvent | null = null;
    grid.addEventListener('pointermove', (e) => {
      last = e;
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        const card = (last?.target as Element | null)?.closest<HTMLElement>('.svc-card');
        if (!card || !last) return;
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${last.clientX - r.left}px`);
        card.style.setProperty('--my', `${last.clientY - r.top}px`);
      });
    });
  }
</script>

<style>
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.8vh, 1.25rem);
  }

  /* Tarjeta de "cristal" */
  .svc-card {
    --mx: 50%;
    --my: 0%;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: clamp(0.9rem, 2.6vh, 1.6rem);
    min-height: 0;
    padding: clamp(1.1rem, 3vh, 1.75rem) clamp(1.1rem, 1.6vw, 1.6rem);
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.09);
    border-radius: 14px;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.055), rgb(255 255 255 / 0.015) 45%, rgb(255 255 255 / 0.01)),
      rgb(18 18 18 / 0.55);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.07),
      0 20px 40px -24px rgb(0 0 0 / 0.7);
    transition:
      border-color 0.5s var(--ease-zen),
      transform 0.5s var(--ease-zen);
  }
  /* Línea superior que se ilumina en cian */
  .svc-card::before {
    content: '';
    position: absolute;
    left: 1.25rem;
    right: 1.25rem;
    top: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
    opacity: 0;
    transform: scaleX(0.3);
    transition:
      opacity 0.5s var(--ease-zen),
      transform 0.6s var(--ease-zen);
  }
  /* Brillo que sigue al cursor */
  .svc-glow {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: radial-gradient(260px circle at var(--mx) var(--my), rgb(255 255 255 / 0.07), transparent 60%);
    opacity: 0;
    transition: opacity 0.4s var(--ease-zen);
  }
  .svc-card:hover {
    border-color: rgb(255 255 255 / 0.16);
    transform: translateY(-2px);
  }
  .svc-card:hover::before {
    opacity: 1;
    transform: scaleX(1);
  }
  .svc-card:hover .svc-glow {
    opacity: 1;
  }

  .svc-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }
  .svc-card :global(.svc-ico) {
    width: clamp(1.75rem, 4.4vh, 2.25rem);
    height: clamp(1.75rem, 4.4vh, 2.25rem);
    color: rgb(255 255 255 / 0.88);
    transition: color 0.4s var(--ease-zen);
  }
  .svc-card :global(.svc-accent) {
    color: var(--color-accent);
    stroke: var(--color-accent);
  }
  .svc-num {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--color-muted);
    transition: color 0.4s var(--ease-zen);
  }
  .svc-card:hover .svc-num {
    color: var(--color-accent);
  }
  .svc-title {
    font-size: clamp(1rem, 2.5vh, 1.25rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--color-fg);
  }
  .svc-desc {
    margin-top: 0.45rem;
    font-size: clamp(0.8rem, 1.85vh, 0.9rem);
    line-height: 1.6;
    color: var(--color-muted);
  }
  .svc-short {
    display: none;
  }
  .svc-arrow {
    position: absolute;
    right: clamp(1.1rem, 1.6vw, 1.6rem);
    bottom: clamp(1rem, 2.6vh, 1.5rem);
    color: var(--color-accent);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.4s var(--ease-zen),
      transform 0.4s var(--ease-zen);
  }
  .svc-card:hover .svc-arrow {
    opacity: 1;
    transform: none;
  }

  /* Los íconos se "dibujan" cada vez que se entra a la sección */
  .svc-card :global(.svc-icon *) {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  :global(html[data-current-section='services']) .svc-card :global(.svc-icon *) {
    animation: svc-draw 1.6s var(--ease-zen) both;
    animation-delay: 0.55s;
  }
  @keyframes svc-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html[data-current-section='services']) .svc-card :global(.svc-icon *) {
      animation: none;
    }
  }

  /* Tablet: 2 columnas y descripciones más cortas */
  @media (max-width: 1023px) {
    .svc-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Teléfono: filas compactas */
  @media (max-width: 767px) {
    .svc-intro {
      display: none;
    }
    .svc-grid {
      grid-template-columns: 1fr;
      gap: 0.55rem;
    }
    .svc-card {
      flex-direction: row;
      align-items: center;
      gap: 1rem;
      padding: clamp(0.7rem, 1.9vh, 1rem) 1rem;
      border-radius: 12px;
    }
    .svc-top {
      flex: none;
    }
    .svc-num {
      display: none;
    }
    .svc-desc {
      display: none;
    }
    .svc-short {
      display: block;
      margin-top: 0.15rem;
      font-size: 0.8rem;
      line-height: 1.4;
      color: var(--color-muted);
    }
    .svc-arrow {
      display: none;
    }
  }
  /* Teléfonos bajos: solo títulos */
  @media (max-width: 767px) and (max-height: 700px) {
    .svc-short {
      display: none;
    }
  }
  /* Escritorio bajo: descripciones a 2 líneas */
  @media (min-width: 768px) and (max-height: 720px) {
    .svc-desc {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }
</style>
