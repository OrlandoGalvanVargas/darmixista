---
import { logoMark } from '../../lib/logo-mark';

interface Props {
  class?: string;
  glow?: boolean;
}
const { class: className, glow = false } = Astro.props;
const uid = `dx${Math.random().toString(36).slice(2, 8)}`;

const markup = logoMark({ id: uid, glow, anim: true });
---

<svg class:list={['logo', className]} viewBox="2 4 100 62" fill="none" aria-hidden="true" set:html={markup} />

<style>
  .logo {
    overflow: visible;
  }
</style>
