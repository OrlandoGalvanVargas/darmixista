---
import { SITE } from '../../config/site';
---

<div data-preloader class="preloader" role="status" aria-live="polite" aria-label={SITE.brand}>
  <div data-preloader-bg class="preloader-bg" aria-hidden="true"></div>
  <canvas data-preloader-canvas class="preloader-canvas" aria-hidden="true"></canvas>
</div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 50;
  }
  .preloader-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, #07100a 0%, #050606 60%);
  }
  .preloader-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>
