---
/**
 * Formulario de contacto (Web3Forms). Se usa en escritorio (junto a los canales) y en el paso
 * móvil. La lógica de envío vive en src/scripts/contact.ts.
 * Estados: data-state="idle | sending | sent | error" en el <form>.
 */
import { SITE, WEB3FORMS_KEY } from '../../config/site';
import { LIMITS } from '../../scripts/contact';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  /** Prefijo para ids únicos (hay dos copias del formulario: escritorio y móvil) */
  idPrefix: string;
}
const { lang, idPrefix } = Astro.props;
const t = useTranslations(lang).contact;
const id = (name: string) => `${idPrefix}-${name}`;
---

<div class="cf-card">
  <form
    class="cf"
    data-contact-form
    data-state="idle"
    data-key={WEB3FORMS_KEY}
    data-email={SITE.contact.email}
    data-subject={t.subject}
    data-msg-required={t.errorRequired}
    data-msg-email={t.errorEmail}
    data-msg-short={t.errorShort}
    data-msg-long={t.errorLong}
    data-msg-name={t.errorName}
    data-msg-links={t.errorLinks}
    data-msg-daily={t.errorDaily}
    data-msg-cooldown={t.errorCooldown}
    data-msg-duplicate={t.errorDuplicate}
    data-msg-error={t.errorGeneric}
    data-label-send={t.send}
    data-label-sending={t.sending}
    novalidate
  >
    <p class="cf-heading">{t.formTitle}</p>

    <div class="cf-row">
      <div class="cf-field">
        <label for={id('name')} class="cf-label">{t.name}</label>
        <input id={id('name')} name="name" type="text" autocomplete="name" required minlength={LIMITS.name.min} maxlength={LIMITS.name.max} placeholder={t.namePh} class="cf-input" />
        <span class="cf-line" aria-hidden="true"></span>
        <p class="cf-error" data-error-for="name" aria-live="polite"></p>
      </div>
      <div class="cf-field">
        <label for={id('email')} class="cf-label">{t.emailField}</label>
        <input id={id('email')} name="email" type="email" inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" required maxlength={LIMITS.email.max} placeholder={t.emailPh} class="cf-input" />
        <span class="cf-line" aria-hidden="true"></span>
        <p class="cf-error" data-error-for="email" aria-live="polite"></p>
      </div>
    </div>

    <fieldset class="cf-field cf-types">
      <legend class="cf-label">{t.type}</legend>
      <div class="flex flex-wrap gap-2">
        {
          t.types.map((type, i) => (
            <label class="cf-chip">
              <input type="radio" name="project_type" value={type} checked={i === 0} class="sr-only" />
              <span>{type}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <div class="cf-field">
      <div class="flex items-baseline justify-between">
        <label for={id('message')} class="cf-label">{t.message}</label>
        <span class="cf-count" data-char-count aria-hidden="true">0/{LIMITS.message.max}</span>
      </div>
      <textarea id={id('message')} name="message" required minlength={LIMITS.message.min} maxlength={LIMITS.message.max} rows="4" placeholder={t.messagePh} class="cf-input cf-textarea"></textarea>
      <span class="cf-line" aria-hidden="true"></span>
      <p class="cf-error" data-error-for="message" aria-live="polite"></p>
    </div>

    <!-- Trampa para bots (Web3Forms la ignora si viene marcada); invisible para personas -->
    <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

    <div class="cf-actions">
      <button type="submit" class="btn btn-primary cf-submit">
        <span class="cf-spinner" aria-hidden="true"></span>
        <span data-submit-label>{t.send}</span>
        <span class="btn-arrow cf-arrow" aria-hidden="true">→</span>
      </button>
      <p class="cf-status" data-form-status role="status" aria-live="polite"></p>
    </div>
  </form>

  <!-- Confirmación -->
  <div class="cf-sent" data-form-sent hidden>
    <svg viewBox="0 0 48 48" class="cf-check" aria-hidden="true">
      <circle cx="24" cy="24" r="22" pathLength="1" />
      <path d="M15 24.5l6 6 12-13" pathLength="1" />
    </svg>
    <p class="mt-5 text-xl font-medium tracking-tight">{t.sentTitle}</p>
    <p class="mt-2 max-w-xs text-sm leading-relaxed text-muted">{t.sentBody}</p>
    <button type="button" class="btn btn-ghost mt-6" data-form-reset>{t.sendAnother}</button>
  </div>
</div>

<style>
  .cf-card {
    position: relative;
    padding: clamp(1.1rem, 3.4vh, 2rem) clamp(1.1rem, 2vw, 2rem);
    border: 1px solid rgb(255 255 255 / 0.09);
    border-radius: 16px;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.05), rgb(255 255 255 / 0.012) 50%),
      rgb(18 18 18 / 0.6);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.07),
      0 30px 60px -30px rgb(0 0 0 / 0.75);
  }
  .cf {
    display: flex;
    flex-direction: column;
    gap: clamp(0.85rem, 2.6vh, 1.5rem);
  }
  .cf-heading {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .cf-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.85rem, 2vw, 1.5rem);
  }
  .cf-field {
    position: relative;
    min-width: 0;
  }
  .cf-count {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: rgb(160 160 160 / 0.6);
    font-variant-numeric: tabular-nums;
  }
  .cf-count[data-warn] {
    color: #ffb86b;
  }
  .cf-types {
    border: 0;
    padding: 0;
    margin: 0;
  }
  .cf-label {
    display: block;
    margin-bottom: 0.35rem;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .cf-types .cf-label {
    margin-bottom: 0.6rem;
  }
  /* Campos de línea: solo un borde inferior que se ilumina en cian al enfocar */
  .cf-input {
    width: 100%;
    padding: 0.45rem 0 0.55rem;
    border: 0;
    border-bottom: 1px solid var(--color-line);
    border-radius: 0;
    background: transparent;
    color: var(--color-fg);
    font-size: clamp(0.9rem, 2.1vh, 1rem);
    outline: none;
    transition: border-color 0.4s var(--ease-zen);
  }
  .cf-input::placeholder {
    color: rgb(160 160 160 / 0.5);
  }
  .cf-textarea {
    resize: none;
    height: clamp(4.25rem, 13vh, 7.5rem);
    line-height: 1.55;
  }
  .cf-line {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    margin-top: -1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease-zen);
  }
  .cf-input:focus-visible {
    outline: none;
  }
  .cf-input:focus + .cf-line {
    transform: scaleX(1);
  }
  .cf-field[data-invalid] .cf-input {
    border-bottom-color: #ff6b6b;
  }
  .cf-error {
    min-height: 0;
    margin-top: 0.3rem;
    font-size: 0.75rem;
    color: #ff8a8a;
  }
  .cf-error:empty {
    display: none;
  }

  /* Píldoras de tipo de proyecto */
  .cf-chip span {
    display: inline-flex;
    padding: 0.3rem 0.9rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: 0.8rem;
    color: rgb(255 255 255 / 0.75);
    cursor: pointer;
    transition:
      border-color 0.35s var(--ease-zen),
      color 0.35s var(--ease-zen),
      background-color 0.35s var(--ease-zen);
  }
  .cf-chip:hover span {
    border-color: var(--color-muted);
  }
  .cf-chip input:checked + span {
    border-color: var(--color-accent);
    color: var(--color-fg);
    background: rgb(0 229 255 / 0.08);
  }
  .cf-chip input:focus-visible + span {
    outline: 1px solid var(--color-accent);
    outline-offset: 3px;
  }

  .cf-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }
  .cf-submit {
    position: relative;
  }
  .cf-status {
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .cf-status[data-tone='error'] {
    color: #ff8a8a;
  }

  /* Enviando: un anillo que gira (eco de los anillos del sitio) */
  .cf-spinner {
    display: none;
    width: 0.95rem;
    height: 0.95rem;
    border: 1.5px solid rgb(18 18 18 / 0.25);
    border-top-color: var(--color-ink);
    border-radius: 999px;
    animation: cf-spin 0.8s linear infinite;
  }
  .cf[data-state='sending'] .cf-spinner {
    display: inline-block;
  }
  .cf[data-state='sending'] .cf-arrow {
    display: none;
  }
  .cf[data-state='sending'] .cf-submit {
    pointer-events: none;
    opacity: 0.85;
  }
  @keyframes cf-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Confirmación */
  .cf-sent {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: clamp(16rem, 52vh, 26rem);
    text-align: center;
  }
  .cf-sent[hidden] {
    display: none;
  }
  .cf-check {
    width: 3.5rem;
    height: 3.5rem;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    animation: cf-draw 1.1s var(--ease-zen) both;
  }
  .cf-check path {
    animation: cf-draw 0.7s var(--ease-zen) 0.5s both;
  }
  @keyframes cf-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Teléfonos bajos: mensaje más compacto */
  @media (max-width: 767px) and (max-height: 700px) {
    .cf {
      gap: 0.7rem;
    }
    .cf-textarea {
      height: 3.6rem;
    }
  }
  @media (max-width: 1023px) {
    .cf-row {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 767px) {
    .cf-heading {
      display: none;
    }
    .cf-submit {
      width: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cf-spinner,
    .cf-check,
    .cf-check path {
      animation: none;
    }
  }
</style>
