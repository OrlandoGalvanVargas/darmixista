---
/**
 * Sección de proyectos en carrusel. Cada diapositiva es un paso del escenario:
 * el scroll recorre los proyectos y, al terminar el último, pasa a la siguiente sección.
 * El encabezado y la navegación no se mueven entre diapositivas.
 */
import ProjectSlide from './ProjectSlide.astro';
import type { Project } from '../../data/projects';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  id: string;
  kind: 'web' | 'mobile';
  title: string;
  projects: Project[];
  lang: Lang;
}
const { id, kind, title, projects, lang } = Astro.props;
const t = useTranslations(lang).projects;
const pad = (n: number) => String(n).padStart(2, '0');
const total = projects.length;
---

<section
  id={id}
  class="stage-section"
  data-section
  data-nav="projects"
  data-rings="background"
  aria-labelledby={`${id}-title`}
  aria-roledescription="carousel"
>
  <div class="section-body" data-section-body>
    <div
      class="mx-auto flex h-full max-w-[1400px] flex-col px-6 pt-[4.5rem] pb-[3.4rem] md:px-12 md:pt-[5.25rem] md:pb-[4.25rem] lg:px-20"
    >
      <header data-reveal class="flex items-end justify-between gap-6 border-b border-line/60 pb-[clamp(0.5rem,1.4vh,0.85rem)]">
        <h2
          id={`${id}-title`}
          class="text-[clamp(1.2rem,min(2.4vw,4.4vh),1.9rem)] leading-none font-semibold tracking-[-0.03em]"
        >
          {title}
        </h2>
        <p class="font-mono text-[11px] tracking-[0.2em] text-muted" aria-live="polite">
          <span data-carousel-index class="text-fg">01</span>
          <span class="mx-1.5 text-line">/</span>{pad(total)}
        </p>
      </header>

      <div class="relative mt-[clamp(0.9rem,3.4vh,2.25rem)] min-h-0 flex-1">
        {projects.map((project, i) => <ProjectSlide project={project} kind={kind} index={i} total={total} lang={lang} />)}
      </div>

      {
        total > 1 ? (
        <nav data-reveal class="mt-[clamp(0.6rem,2.2vh,1.4rem)] flex items-center justify-center gap-5" aria-label={title}>
          <button type="button" class="carousel-arrow" data-carousel-prev aria-label={t.prev}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M19 12H5m6-6-6 6 6 6" /></svg>
          </button>
          <div class="flex items-center gap-2">
            {
              projects.map((p, i) => (
                <button type="button" class="carousel-tick" data-carousel-goto={i} aria-label={`${t.goTo} ${pad(i + 1)}: ${p.title}`} />
              ))
            }
          </div>
          <button type="button" class="carousel-arrow" data-carousel-next aria-label={t.next}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
          </button>
        </nav>
        ) : (
          // Un solo proyecto: sin flechas, pero se conserva el espacio para que el diseño no cambie
          <div class="mt-[clamp(0.6rem,2.2vh,1.4rem)] h-10" aria-hidden="true" />
        )
      }
    </div>
  </div>
</section>
