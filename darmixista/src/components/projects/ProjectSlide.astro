---
/**
 * Una diapositiva del carrusel: texto a la izquierda, mockup a la derecha (debajo en móvil).
 * Los tamaños dependen del alto de la pantalla para que todo quepa sin desplazamiento.
 */
import BrowserMockup from './BrowserMockup.astro';
import PhoneMockup from './PhoneMockup.astro';
import type { Project } from '../../data/projects';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  project: Project;
  kind: 'web' | 'mobile';
  index: number;
  total: number;
  lang: Lang;
}
const { project: p, kind, index, total, lang } = Astro.props;
const t = useTranslations(lang).projects;
const pad = (n: number) => String(n).padStart(2, '0');

const primary =
  kind === 'web'
    ? p.links.demo && { href: p.links.demo, label: t.demo, internal: false }
    : p.links.page && { href: getRelativeLocaleUrl(lang, `${p.links.page}/`), label: t.getApp, internal: true };
---

<article
  data-slide
  class:list={[
    'slide absolute inset-0 grid grid-cols-1 grid-rows-[auto_minmax(0,1fr)] gap-[clamp(0.9rem,3vh,1.75rem)]',
    'lg:grid-cols-12 lg:grid-rows-1 lg:items-center lg:gap-10',
  ]}
  aria-roledescription="slide"
  aria-label={`${pad(index + 1)} / ${pad(total)} — ${p.title}`}
>
  <!-- Texto -->
  <div class:list={['relative isolate', kind === 'web' ? 'lg:col-span-5' : 'lg:col-span-5 lg:col-start-2']}>
    <span data-reveal class="slide-num" aria-hidden="true">{pad(index + 1)}</span>

    <p data-reveal class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11px] tracking-[0.18em] text-muted uppercase">
      <span class="text-accent">{p.year}</span>
      <span class="h-px w-5 bg-line" aria-hidden="true"></span>
      <span>{p.category[lang]}</span>
      {p.inProgress && <span class="status-badge">{t.inProgress}</span>}
    </p>

    <h3
      data-reveal
      class="mt-[clamp(0.5rem,1.6vh,1rem)] text-[clamp(1.9rem,min(4.2vw,8vh),4.1rem)] leading-[0.98] font-semibold tracking-[-0.035em]"
    >
      {p.title}
    </h3>

    <p
      data-reveal
      class="slide-summary mt-[clamp(0.6rem,2vh,1.25rem)] line-clamp-3 max-w-[32rem] text-[clamp(0.88rem,2.1vh,1.05rem)] leading-relaxed text-muted lg:line-clamp-4"
    >
      {p.summary[lang]}
    </p>

    <ul data-reveal class="slide-tags mt-[clamp(0.75rem,2.4vh,1.4rem)] flex flex-wrap gap-2" aria-label={t.technologies}>
      {p.tags.slice(0, 4).map((tag, i) => <li class:list={['chip', i === 3 && 'max-md:hidden']}>{tag}</li>)}
    </ul>

    <div data-reveal class="mt-[clamp(1rem,3.6vh,2.25rem)] flex flex-wrap gap-2.5 md:gap-3">
      {
        primary ? (
          <a
            href={primary.href}
            class="btn btn-primary btn-adapt"
            {...(primary.internal ? {} : { target: '_blank', rel: 'noopener noreferrer' })}
          >
            {primary.label}
            <span class="btn-arrow" aria-hidden="true">{primary.internal ? '→' : '↗'}</span>
          </a>
        ) : (
          <span class="btn btn-ghost btn-adapt is-disabled" aria-disabled="true">{t.soon}</span>
        )
      }
      {
        p.links.code && (
          <a href={p.links.code} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-adapt">
            {t.code}
          </a>
        )
      }
      <button
        type="button"
        class="btn btn-ghost btn-adapt btn-details"
        data-open-dialog={`project-${p.slug}`}
        aria-label={`${t.details}: ${p.title}`}
      >
        <span class="btn-details-label">{t.details}</span>
        <svg class="btn-details-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
      </button>
    </div>
  </div>

  <!-- Mockup -->
  <div
    data-slide-media
    class:list={[
      'media flex min-h-0 items-center justify-center',
      kind === 'web' ? 'lg:col-span-7 lg:h-full lg:justify-end' : 'lg:col-span-5 lg:h-full',
    ]}
  >
    <div class={kind === 'web' ? 'fit-web' : 'fit-phone'}>
      {
        kind === 'web' ? (
          <BrowserMockup image={p.image} domain={p.domain} title={p.title} />
        ) : (
          <PhoneMockup image={p.image} title={p.title} />
        )
      }
    </div>
  </div>
</article>

<style>
  .media {
    container-type: size;
    height: 100%;
  }
  /* El mockup ocupa el mayor tamaño posible sin salirse de su caja */
  .fit-web {
    width: min(100cqw, 100cqh * 1.55);
    aspect-ratio: 1.55;
  }
  .fit-phone {
    height: min(100cqh, 100cqw / 0.469);
  }

  /* Número gigante de contorno detrás del texto (índice de carátula) */
  .slide-num {
    position: absolute;
    z-index: -1;
    top: -0.32em;
    left: -0.06em;
    font-size: clamp(7rem, 26vh, 15rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1px rgb(255 255 255 / 0.07);
    pointer-events: none;
    user-select: none;
  }
  @media (max-width: 1023px) {
    .slide-num {
      display: none;
    }
  }

  /* "Detalles": en teléfono es un botón de ícono para que los tres botones quepan en una fila */
  .btn-details-icon {
    display: none;
    width: 1rem;
    height: 1rem;
  }
  @media (max-width: 767px) {
    .btn-details {
      width: 2.6rem;
      padding-inline: 0;
    }
    .btn-details-label {
      display: none;
    }
    .btn-details-icon {
      display: block;
    }
  }

  /* Pantallas bajas apiladas: resumen a 2 líneas y sin chips (siguen en "Detalles") para dar aire al mockup */
  @media (max-width: 1023px) and (max-height: 720px) {
    .slide-summary {
      -webkit-line-clamp: 2;
    }
    .slide-tags {
      display: none;
    }
  }

  .status-badge {
    padding: 0.1rem 0.55rem;
    border: 1px solid rgb(0 229 255 / 0.35);
    border-radius: 999px;
    color: var(--color-accent);
    letter-spacing: 0.14em;
    font-size: 9.5px;
  }
</style>
