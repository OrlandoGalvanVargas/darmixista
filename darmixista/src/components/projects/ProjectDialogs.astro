---
/**
 * Paneles de "Detalles" (uno por proyecto). Viven fuera del escenario para no heredar
 * transformaciones ni el estado inerte de las secciones. Los abre src/scripts/dialogs.ts.
 * Escritorio: panel lateral derecho. Móvil: hoja inferior.
 */
import type { Project } from '../../data/projects';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  projects: Array<{ project: Project; kind: 'web' | 'mobile' }>;
  lang: Lang;
}
const { projects, lang } = Astro.props;
const t = useTranslations(lang).projects;
---

{
  projects.map(({ project: p, kind }) => {
    const primary =
      kind === 'web'
        ? p.links.demo && { href: p.links.demo, label: t.demo, internal: false }
        : p.links.page && { href: getRelativeLocaleUrl(lang, `${p.links.page}/`), label: t.getApp, internal: true };
    return (
      <dialog id={`project-${p.slug}`} class="project-dialog" aria-labelledby={`project-${p.slug}-title`}>
        <div class="dialog-panel">
          <header class="flex items-start justify-between gap-6">
            <div>
              <p class="font-mono text-[11px] tracking-[0.18em] text-muted uppercase">
                <span class="text-accent">{p.year}</span> · {p.category[lang]}
              </p>
              <h3 id={`project-${p.slug}-title`} class="mt-3 text-3xl font-semibold tracking-[-0.03em] md:text-4xl">
                {p.title}
              </h3>
            </div>
            <button type="button" class="dialog-close" data-close-dialog aria-label={t.close}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M6 6l12 12M18 6 6 18" /></svg>
            </button>
          </header>

          <p class="mt-6 leading-relaxed text-muted">{p.description[lang]}</p>

          {p.highlights && (
            <section class="mt-8">
              <h4 class="font-mono text-[11px] tracking-[0.24em] text-accent uppercase">{t.highlights}</h4>
              <ul class="mt-4 space-y-3">
                {p.highlights[lang].map((h) => (
                  <li class="flex gap-3 text-[15px] leading-snug">
                    <span class="mt-[0.55em] h-px w-3 flex-none bg-accent" aria-hidden="true" />
                    {h}
                  </li>
                ))}
              </ul>
            </section>
          )}

          <section class="mt-8">
            <h4 class="font-mono text-[11px] tracking-[0.24em] text-accent uppercase">{t.technologies}</h4>
            <ul class="mt-4 flex flex-wrap gap-2">
              {p.tags.map((tag) => <li class="chip">{tag}</li>)}
            </ul>
          </section>

          <div class="mt-10 flex flex-wrap gap-3 border-t border-line/70 pt-6">
            {primary ? (
              <a
                href={primary.href}
                class="btn btn-primary"
                {...(primary.internal ? {} : { target: '_blank', rel: 'noopener noreferrer' })}
              >
                {primary.label}
                <span class="btn-arrow" aria-hidden="true">{primary.internal ? '→' : '↗'}</span>
              </a>
            ) : (
              <span class="btn btn-ghost is-disabled" aria-disabled="true">{t.soon}</span>
            )}
            {p.links.code && (
              <a href={p.links.code} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
                {t.code}
              </a>
            )}
          </div>
        </div>
      </dialog>
    );
  })
}
