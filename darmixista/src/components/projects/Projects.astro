---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { BUSINESS_APPS, PERSONAL_APPS, WEB_PROJECTS, type Project } from '../../data/projects';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang).projects;
const pad = (n: number) => String(n).padStart(2, '0');

const groups = [
  { key: 'web', label: t.tabs.web, tag: 'WEB', items: WEB_PROJECTS },
  { key: 'mobile', label: t.tabs.mobile, tag: 'APP', items: BUSINESS_APPS },
  { key: 'personal', label: t.tabs.personal, tag: 'APP', items: PERSONAL_APPS },
] as const;
const first = groups.find((g) => g.items.length)?.key ?? 'web';

const primaryLink = (p: Project) =>
  p.links.demo
    ? { href: p.links.demo, label: t.demo, external: true }
    : p.links.page
      ? { href: getRelativeLocaleUrl(lang, `${p.links.page}/`), label: t.getApp, external: false }
      : null;

const all = groups.flatMap((g) => g.items.map((p, i) => ({ p, g, i })));
const arrow = 'M5 12h14M13 6l6 6-6 6';
const arrowUp = 'M7 17 17 7M9 7h8v8';
---

<section id="projects" class="stage-section" data-section data-nav="projects" data-rings="background" aria-labelledby="projects-title">
  <div class="section-body" data-section-body>
    <div class="crate-frame">
      <header class="crate-head">
        <h2 id="projects-title" data-reveal class="crate-title">{t.title}</h2>
        <div class="crate-tabs" role="tablist" aria-label={t.tabsLabel} data-reveal-sub data-crate-tabs>
          {
            groups.map((g) => (
              <button
                type="button"
                role="tab"
                id={`crate-tab-${g.key}`}
                aria-controls={`crate-${g.key}`}
                aria-selected={g.key === first ? 'true' : 'false'}
                tabindex={g.key === first ? 0 : -1}
                disabled={!g.items.length}
                data-crate-tab={g.key}
                class="crate-tab"
              >
                <span class="crate-tab-label">{g.label}</span>
                <sup>{g.items.length ? pad(g.items.length) : t.soon}</sup>
              </button>
            ))
          }
          <span class="crate-tab-pill" aria-hidden="true"></span>
        </div>
      </header>

      <div class="crate-stage" data-reveal-sub>
        {
          groups
            .filter((g) => g.items.length)
            .map((g) => (
              <div
                id={`crate-${g.key}`}
                role="tabpanel"
                aria-labelledby={`crate-tab-${g.key}`}
                class="crate"
                data-crate={g.key}
                hidden={g.key !== first}
              >
                <div class="crate-track" data-crate-track data-hscroll>
                  {g.items.map((p, i) => (
                    <button type="button" class="record" data-record={p.slug} aria-label={`${t.open} ${p.title}`}>
                      <span class="record-art">
                        <span class="disc" data-disc>
                          <span class="disc-label">
                            <span class="disc-name">{p.title}</span>
                          </span>
                        </span>
                        <span class="sleeve">
                          {p.cover && <img src={p.cover} alt="" loading="lazy" decoding="async" />}
                          <span class="sleeve-tint" />
                          <span class="sleeve-cat">
                            <span>DMX · {pad(i + 1)}</span>
                            <span>{g.tag}</span>
                          </span>
                          <span class="sleeve-title">{p.title}</span>
                        </span>
                      </span>
                      <span class="record-meta">
                        <span class="record-cat">{p.category[lang]}</span>
                        <span class="record-year">{p.year}</span>
                      </span>
                    </button>
                  ))}
                </div>
              </div>
            ))
        }
        <button type="button" class="crate-nav crate-nav-prev" data-crate-prev aria-label={t.less} hidden>
          <svg viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
        </button>
        <button type="button" class="crate-nav crate-nav-next" data-crate-next aria-label={t.more} hidden>
          <svg viewBox="0 0 24 24" fill="none"><path d={arrow} /></svg>
        </button>
      </div>
      <div class="crate-progress" data-crate-progress aria-hidden="true" hidden><i></i></div>
    </div>
  </div>
</section>

<div class="vinyl-modal" data-vinyl-modal role="dialog" aria-modal="true" hidden>
  <div class="vm-backdrop" data-vm-close></div>
  <button type="button" class="vm-close" data-vm-close aria-label={t.close}>
    <svg viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6 6 18" /></svg>
  </button>
  <div class="vm-scroll">
    <div class="vm-grid">
      <div class="vm-left">
        <div class="vm-stage" data-vm-stage>
          <div class="vm-slot" data-vm-slot></div>
          {
            all.map(({ p }) =>
              p.shots?.length ? (
                <div class="vm-screen" data-vm-for={p.slug} data-vm-screen hidden aria-label={t.shotsLabel} role="region">
                  {p.shots.map((src, n) => (
                    <figure class="vm-shot" data-vm-shot>
                      <img data-src={src} alt={`${p.title} · ${n + 1}`} decoding="async" />
                    </figure>
                  ))}
                </div>
              ) : null,
            )
          }
        </div>
        {
          all.map(({ p }) =>
            p.shots?.length ? (
              <div class="vm-bars" data-vm-for={p.slug} data-vm-bars hidden>
                {p.shots.map((_, n) => (
                  <button type="button" class="vm-bar" data-vm-bar={n} aria-label={`${t.shotGo} ${n + 1}`}>
                    <i />
                  </button>
                ))}
                <span class="vm-count" aria-hidden="true">
                  <b data-vm-index>01</b> / {pad(p.shots.length)}
                </span>
              </div>
            ) : null,
          )
        }
      </div>
      {
        all.map(({ p, g }) => {
          const main = primaryLink(p);
          return (
            <article class="vm-info" data-vm-for={p.slug} hidden>
              <p class="vm-kicker" data-vm-anim>
                <span>{p.category[lang]}</span>
                <span>{p.year}</span>
                <span>{g.label}</span>
              </p>
              <h3 class="vm-title" data-vm-anim id={`vm-title-${p.slug}`}>
                {p.title}
              </h3>
              <p class="vm-summary" data-vm-anim>
                {(p.summaryShort ?? p.summary)[lang]}
              </p>
              {p.highlights && (
                <div class="vm-tracks" data-vm-anim>
                  <p class="vm-side">{t.sideA}</p>
                  <ol>
                    {p.highlights[lang].map((h, n) => (
                      <li>
                        <span>{pad(n + 1)}</span>
                        {h}
                      </li>
                    ))}
                  </ol>
                </div>
              )}
              <ul class="vm-tags" data-vm-anim>
                {p.tags.slice(0, 5).map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
              <div class="vm-actions" data-vm-anim>
                {main && (
                  <a href={main.href} class="dbtn dbtn-solid" {...(main.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                    <span class="dbtn-text"><span data-text={main.label}>{main.label}</span></span>
                    <span class="dbtn-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none"><path d={main.external ? arrowUp : arrow} /></svg>
                      <svg viewBox="0 0 24 24" fill="none"><path d={main.external ? arrowUp : arrow} /></svg>
                    </span>
                  </a>
                )}
                {p.links.code && (
                  <a href={p.links.code} target="_blank" rel="noopener noreferrer" class="dbtn dbtn-line">
                    <span class="dbtn-text"><span data-text={t.code}>{t.code}</span></span>
                    <span class="dbtn-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none"><path d="m8 7-5 5 5 5M16 7l5 5-5 5" /></svg>
                      <svg viewBox="0 0 24 24" fill="none"><path d="m8 7-5 5 5 5M16 7l5 5-5 5" /></svg>
                    </span>
                  </a>
                )}
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</div>
