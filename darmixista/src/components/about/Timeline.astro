---
/**
 * Trayectoria: un riel vertical continuo con dos grupos (Experiencia y Formación).
 * Al entrar, el riel cian se "dibuja" de arriba hacia abajo y los hitos aparecen en orden.
 * Los datos viven en src/data/trajectory.ts.
 */
import { EDUCATION, EXPERIENCE, type TimelineEntry } from '../../data/trajectory';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  experienceLabel: string;
  educationLabel: string;
}
const { lang, experienceLabel, educationLabel } = Astro.props;

const groups: Array<{ label: string; entries: TimelineEntry[] }> = [
  { label: experienceLabel, entries: EXPERIENCE },
  { label: educationLabel, entries: EDUCATION },
];
---

<div class="timeline relative pl-8">
  <!-- Riel base + trazo cian que se dibuja al entrar -->
  <span class="absolute top-1.5 bottom-1.5 left-[5px] w-px bg-line" aria-hidden="true"></span>
  <span
    data-draw="y"
    class="timeline-trace absolute top-1.5 bottom-1.5 left-[5px] w-px origin-top"
    aria-hidden="true"></span>

  {
    groups.map((group, g) => (
      <section class:list={[g > 0 && 'mt-[clamp(1.1rem,3.6vh,2.25rem)]']}>
        <h3 data-reveal class="relative font-mono text-[11px] tracking-[0.28em] text-accent uppercase">
          <span class="absolute top-1/2 -left-8 h-px w-4 -translate-y-1/2 bg-accent/60" aria-hidden="true" />
          {group.label}
        </h3>
        <ol class="mt-[clamp(0.6rem,1.8vh,1.1rem)] space-y-[clamp(0.75rem,2.4vh,1.5rem)]">
          {group.entries.map((entry) => (
            <li data-reveal class="relative">
              <span
                class:list={['timeline-node', entry.current && 'timeline-node--current']}
                aria-hidden="true"
              />
              <p class="font-mono text-[11px] tracking-[0.14em] text-muted">{entry.period[lang]}</p>
              <p class="mt-1 text-[clamp(0.92rem,2.1vh,1.05rem)] leading-snug font-medium tracking-tight text-fg">
                {entry.title[lang]}
                <span class="font-normal text-muted"> · {entry.org}</span>
              </p>
              {entry.description && (
                <p class="timeline-desc mt-1 max-w-[30rem] text-[clamp(0.8rem,1.8vh,0.9rem)] leading-relaxed text-muted">
                  {entry.description[lang]}
                </p>
              )}
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .timeline-trace {
    background: linear-gradient(to bottom, var(--color-accent), rgb(0 229 255 / 0.15) 70%, transparent);
  }
  .timeline-node {
    position: absolute;
    left: calc(-2rem + 1px);
    top: 0.2rem;
    width: 9px;
    height: 9px;
    border-radius: 999px;
    border: 1px solid var(--color-muted);
    background: var(--color-ink);
  }
  .timeline-node--current {
    border-color: var(--color-accent);
    background: var(--color-accent);
    box-shadow: 0 0 0 4px rgb(0 229 255 / 0.12), 0 0 14px rgb(0 229 255 / 0.55);
  }
  .timeline-node--current::after {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 999px;
    border: 1px solid rgb(0 229 255 / 0.5);
    animation: node-pulse 2.4s var(--ease-zen) infinite;
  }
  @keyframes node-pulse {
    0% { transform: scale(0.6); opacity: 1; }
    100% { transform: scale(1.8); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .timeline-node--current::after { animation: none; }
  }
  /* Pantallas bajas: se ocultan las descripciones para que todo quepa */
  @media (max-height: 700px) {
    .timeline-desc { display: none; }
  }
  /* Escritorio angosto (columna estrecha junto al stack) en pantallas no muy altas: igual se ocultan */
  @media (min-width: 1024px) and (max-width: 1279px) and (max-height: 900px) {
    .timeline-desc { display: none; }
  }
</style>
