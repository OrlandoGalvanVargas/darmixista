---
/**
 * Stack como "ficha técnica": una fila por categoría con su índice, nombre y píldoras.
 * Las tecnologías `core` llevan un punto cian. En teléfonos bajos solo se ven las `core`.
 */
import { STACK } from '../../data/stack';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  coreLabel: string;
  /** Diseño de una columna centrado (móvil) */
  compact?: boolean;
}
const { lang, coreLabel, compact = false } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class:list={['stack-list', { 'stack-list--compact': compact }]}>
  <ul class="border-t border-line/70">
    {
      STACK.map((category, i) => (
        <li
          data-reveal
          class:list={[
            'group border-b border-line/70 transition-colors duration-500',
            compact
              ? 'py-[clamp(0.6rem,1.8vh,1rem)] text-center'
              : 'grid grid-cols-[minmax(7.5rem,9.5rem)_1fr] items-baseline gap-x-6 py-[clamp(0.7rem,2.1vh,1.25rem)] hover:bg-white/[0.015]',
          ]}
        >
          <p class:list={['flex items-baseline gap-3', compact && 'justify-center']}>
            <span class="font-mono text-[11px] tracking-[0.2em] text-accent">{pad(i + 1)}</span>
            <span class="text-[clamp(0.95rem,2.2vh,1.15rem)] font-medium tracking-tight text-fg">
              {category.label[lang]}
            </span>
          </p>
          <ul class:list={['flex flex-wrap gap-[clamp(0.35rem,0.9vh,0.5rem)]', compact ? 'mt-2.5 justify-center' : '']}>
            {category.items.map((item) => (
              <li data-reveal-sub class:list={['pill', item.core ? 'pill--core' : 'pill--extra']}>
                {item.core && <span class="pill-dot" aria-hidden="true" />}
                {item.name}
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
  <p data-reveal class:list={['mt-4 flex items-center gap-2 font-mono text-[10px] tracking-[0.2em] text-muted uppercase', compact && 'justify-center']}>
    <span class="pill-dot" aria-hidden="true"></span>
    {coreLabel}
  </p>
</div>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: clamp(0.2rem, 0.6vh, 0.32rem) 0.8rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: clamp(0.75rem, 1.6vh, 0.82rem);
    line-height: 1.4;
    color: rgb(255 255 255 / 0.82);
    transition:
      border-color 0.4s var(--ease-zen),
      color 0.4s var(--ease-zen),
      background-color 0.4s var(--ease-zen);
  }
  .pill:hover {
    border-color: var(--color-accent);
    color: var(--color-fg);
    background: rgb(0 229 255 / 0.05);
  }
  .pill--core {
    border-color: rgb(255 255 255 / 0.28);
    color: var(--color-fg);
  }
  .pill-dot {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--color-accent);
    box-shadow: 0 0 8px rgb(0 229 255 / 0.6);
    flex: none;
  }

  /* Teléfonos de pantalla baja: solo las tecnologías principales */
  @media (max-width: 767px) and (max-height: 740px) {
    .stack-list--compact .pill--extra {
      display: none;
    }
  }
</style>
