---
import Logo from '../brand/Logo.astro';
import LangSwitch from './LangSwitch.astro';
import { NAV_ITEMS } from '../../config/sections';
import { SITE } from '../../config/site';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const github = SITE.socials.find((x) => x.id === 'github');
const linkedin = SITE.socials.find((x) => x.id === 'linkedin');
---

<header class="site-header fixed inset-x-0 top-0 z-30">
  <div
    class="mx-auto flex h-16 max-w-[1400px] items-center justify-between px-6 md:h-[4.5rem] md:px-12 lg:px-20"
  >
    <a href="#home" data-goto="home" class="group flex items-center gap-3" aria-label={SITE.brand}>
      <Logo class="nav-logo h-8 w-8 text-fg" />
      <span class="text-[13px] font-semibold tracking-[0.26em] uppercase">{SITE.brand}</span>
    </a>
    <nav aria-label={t.nav.label} class="hidden items-center gap-6 lg:flex xl:gap-9">
      <ul class="flex items-center gap-7 text-[14px] font-medium tracking-[0.01em] whitespace-nowrap xl:gap-9">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a href={`#${item.id}`} data-goto={item.id} data-nav-item={item.id} class="nav-link">
                {t.nav[item.key]}
              </a>
            </li>
          ))
        }
      </ul>
      <span class="h-4 w-px bg-line" aria-hidden="true"></span>
      <LangSwitch lang={lang} label={t.nav.language} />
    </nav>
    <div class="flex items-center gap-5 lg:hidden">
      <LangSwitch lang={lang} label={t.nav.language} />
      <button
        type="button"
        class="menu-btn flex h-10 w-10 flex-col items-center justify-center gap-[6px] rounded-md border border-line text-fg"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.nav.openMenu}
        data-label-open={t.nav.openMenu}
        data-label-close={t.nav.closeMenu}
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div data-menu-backdrop class="menu-backdrop fixed inset-0 z-[-1] lg:hidden" aria-hidden="true"></div>
  <div id="mobile-menu" data-mobile-menu class="mobile-menu fixed inset-x-0 z-[-1] lg:hidden">
    <nav aria-label={t.nav.label}>
      <ul class="flex flex-col items-center gap-1">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a href={`#${item.id}`} data-goto={item.id} data-nav-item={item.id} class="menu-item">
                {t.nav[item.key]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="menu-social">
      {github && (
        <a href={github.href} target="_blank" rel="noopener noreferrer" aria-label={github.label}>
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.66 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"/></svg>
        </a>
      )}
      {linkedin && (
        <a href={linkedin.href} target="_blank" rel="noopener noreferrer" aria-label={linkedin.label}>
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M3.58 5.5H.9V15h2.68V5.5ZM2.24 1A1.55 1.55 0 1 0 2.25 4.1 1.55 1.55 0 0 0 2.24 1ZM15.1 9.28c0-2.55-1.36-3.98-3.36-3.98-1.5 0-2.25.83-2.62 1.41V5.5H6.45V15h2.67v-4.9c0-1.29.25-2.54 1.85-2.54 1.58 0 1.6 1.48 1.6 2.62V15h2.53V9.28Z"/></svg>
        </a>
      )}
      <a href={`mailto:${SITE.contact.email}`} aria-label={t.contact.email}>
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="1.5" y="3" width="13" height="10" rx="2" stroke="currentColor" stroke-width="1.3"/><path d="m2.5 4.5 5.5 4 5.5-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>
</header>

<style>
  .nav-logo :global(.logo-front),
  .nav-logo :global(.logo-back) {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 0;
  }
  .group:hover .nav-logo :global(.logo-front),
  .group:focus-visible .nav-logo :global(.logo-front) {
    animation: nav-ring-draw 0.9s var(--ease-zen) both;
  }
  .group:hover .nav-logo :global(.logo-back),
  .group:focus-visible .nav-logo :global(.logo-back) {
    animation: nav-ring-draw 0.9s var(--ease-zen) 0.12s both;
  }
  .nav-logo :global(.logo-dot) {
    transition: scale 0.5s var(--ease-zen);
  }
  .group:hover .nav-logo :global(.logo-dot),
  .group:focus-visible .nav-logo :global(.logo-dot) {
    scale: 1.35;
  }
  @keyframes nav-ring-draw {
    from {
      stroke-dashoffset: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .group:hover .nav-logo :global(.logo-front),
    .group:hover .nav-logo :global(.logo-back) {
      animation: none;
    }
  }
</style>
