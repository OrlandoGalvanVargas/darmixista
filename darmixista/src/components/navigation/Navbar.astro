---
import Logo from '../brand/Logo.astro';
import LangSwitch from './LangSwitch.astro';
import { NAV_ITEMS } from '../../config/sections';
import { SITE } from '../../config/site';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const github = SITE.socials.find((x) => x.id === 'github');
const linkedin = SITE.socials.find((x) => x.id === 'linkedin');
---

<header class="site-header fixed inset-x-0 top-0 z-30">
  <div
    class="mx-auto flex h-16 max-w-[1400px] items-center justify-between px-6 md:h-[4.5rem] md:px-12 lg:px-20"
  >
    <a href="#home" data-goto="home" class="group nav-brand" aria-label={SITE.brand}>
      <span class="wordmark" aria-hidden="true">
        {[...SITE.brand].map((c) => (
          <span class="wm">{c}</span>
        ))}
      </span>
      <Logo class="nav-logo h-8 w-8" />
    </a>
    <nav aria-label={t.nav.label} class="hidden items-center gap-9 lg:flex xl:gap-11">
      <ul class="flex items-center gap-8 text-[14px] font-medium tracking-[0.01em] whitespace-nowrap xl:gap-10">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a href={`#${item.id}`} data-goto={item.id} data-nav-item={item.id} class="nav-link">
                <span class="roll" data-roll>{t.nav[item.key]}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <span class="nav-divider" aria-hidden="true"></span>
      <LangSwitch lang={lang} label={t.nav.switchTo} />
    </nav>
    <div class="nav-mobile flex items-center gap-5 max-[359px]:gap-3.5 lg:hidden">
      <LangSwitch lang={lang} label={t.nav.switchTo} />
      <span class="nav-divider" aria-hidden="true"></span>
      <button
        type="button"
        class="menu-btn"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.nav.openMenu}
        data-label-open={t.nav.openMenu}
        data-label-close={t.nav.closeMenu}
      >
        <span class="menu-btn-text" data-state="closed">{t.nav.menu}</span>
        <span class="menu-btn-text" data-state="open" aria-hidden="true">{t.nav.close}</span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" data-mobile-menu class="menu-overlay lg:hidden">
    <span class="menu-slats" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span>
    <span class="menu-glow" aria-hidden="true"></span>
    <span class="menu-seal" aria-hidden="true">
      <svg class="menu-seal-svg" viewBox="0 0 100 100">
        <defs>
          <path id="menu-seal-path" d="M50 50m-40 0a40 40 0 1 1 80 0a40 40 0 1 1-80 0" />
        </defs>
        <circle cx="50" cy="50" r="46.5" />
        <circle cx="50" cy="50" r="33" />
        <text text-anchor="middle"><textPath href="#menu-seal-path" startOffset="16.667%" textLength="62" lengthAdjust="spacing">DARMIXISTA</textPath></text>
        <text text-anchor="middle"><textPath href="#menu-seal-path" startOffset="50%" textLength="62" lengthAdjust="spacing">DARMIXISTA</textPath></text>
        <text text-anchor="middle"><textPath href="#menu-seal-path" startOffset="83.333%" textLength="62" lengthAdjust="spacing">DARMIXISTA</textPath></text>
        <circle class="dot" cx="7.2" cy="50" r="1.1" />
        <circle class="dot" cx="71.4" cy="12.93" r="1.1" />
        <circle class="dot" cx="71.4" cy="87.07" r="1.1" />
      </svg>
    </span>

    <div class="menu-inner">
      <p class="menu-kicker" data-menu-fade>{t.nav.menu}</p>
      <nav aria-label={t.nav.label}>
        <ul class="menu-list">
          {
            NAV_ITEMS.map((item) => (
              <li class="menu-row">
                <a href={`#${item.id}`} data-goto={item.id} data-nav-item={item.id} class="menu-item" aria-label={t.nav[item.key]}>
                  <span class="menu-label" aria-hidden="true">
                    {[...t.nav[item.key]].map((c) => (
                      <span class="mc">{c === ' ' ? '\u00a0' : c}</span>
                    ))}
                  </span>
                  <span class="menu-hint" aria-hidden="true">{t.nav.hints[item.key]}</span>
                </a>
                <span class="menu-line" aria-hidden="true"></span>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="menu-foot" data-menu-fade>
        <p class="menu-idea">
          <span class="menu-idea-title">{t.nav.ideaTitle}</span>
          <span class="menu-idea-text">{t.nav.ideaText}</span>
        </p>
        <div class="menu-foot-row">
          <div class="menu-social">
            {github && (
              <a href={github.href} target="_blank" rel="noopener noreferrer" aria-label={github.label}>
                <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.66 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"/></svg>
              </a>
            )}
            {linkedin && (
              <a href={linkedin.href} target="_blank" rel="noopener noreferrer" aria-label={linkedin.label}>
                <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M3.58 5.5H.9V15h2.68V5.5ZM2.24 1A1.55 1.55 0 1 0 2.25 4.1 1.55 1.55 0 0 0 2.24 1ZM15.1 9.28c0-2.55-1.36-3.98-3.36-3.98-1.5 0-2.25.83-2.62 1.41V5.5H6.45V15h2.67v-4.9c0-1.29.25-2.54 1.85-2.54 1.58 0 1.6 1.48 1.6 2.62V15h2.53V9.28Z"/></svg>
              </a>
            )}
            <a href={`mailto:${SITE.contact.email}`} aria-label={t.contact.email}>
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="1.5" y="3" width="13" height="10" rx="2" stroke="currentColor" stroke-width="1.3"/><path d="m2.5 4.5 5.5 4 5.5-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .nav-brand {
    display: flex;
    align-items: center;
    -webkit-tap-highlight-color: transparent;
  }
  .wordmark {
    display: inline-flex;
    margin-right: -0.24em;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.24em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-fg);
  }
  @media (min-width: 768px) {
    .wordmark {
      font-size: 15px;
    }
  }
  .wm {
    display: inline-block;
    transition:
      transform 0.5s var(--ease-zen),
      color 0.4s var(--ease-zen);
  }
  @media (hover: hover) {
    .group:hover .wm,
    .group:focus-visible .wm {
      transform: translateY(-3px);
      color: var(--color-accent-hi);
    }
    .group:hover .wm:nth-child(1) { transition-delay: 0s; }
    .group:hover .wm:nth-child(2) { transition-delay: 0.025s; }
    .group:hover .wm:nth-child(3) { transition-delay: 0.05s; }
    .group:hover .wm:nth-child(4) { transition-delay: 0.075s; }
    .group:hover .wm:nth-child(5) { transition-delay: 0.1s; }
    .group:hover .wm:nth-child(6) { transition-delay: 0.125s; }
    .group:hover .wm:nth-child(7) { transition-delay: 0.15s; }
    .group:hover .wm:nth-child(8) { transition-delay: 0.175s; }
    .group:hover .wm:nth-child(9) { transition-delay: 0.2s; }
    .group:hover .wm:nth-child(10) { transition-delay: 0.225s; }
  }
  .nav-brand.is-pulsing .wm {
    transform: none;
    color: var(--color-fg);
    transition-delay: 0s;
  }

  .nav-brand :global(.nav-logo) {
    display: none;
  }
  @media (max-width: 339px) {
    .wordmark {
      display: none;
    }
    .nav-brand :global(.nav-logo) {
      display: block;
    }
  }
  .nav-logo :global(.logo-green) {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 0;
  }
  @media (hover: hover) {
    .group:hover .nav-logo :global(.logo-green) {
      animation: nav-logo-draw 0.9s var(--ease-zen) both;
    }
  }
  @keyframes nav-logo-draw {
    from {
      stroke-dashoffset: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .group:hover .wm {
      transform: none;
    }
    .group:hover .nav-logo :global(.logo-green) {
      animation: none;
    }
  }
</style>
