---
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  total: number;
}
const { lang, total } = Astro.props;
const t = useTranslations(lang);
---

<div class="pointer-events-none fixed inset-x-0 bottom-0 z-20">
  <div class="relative mx-auto flex max-w-[1400px] items-end justify-end px-6 pb-5 md:px-12 md:pb-7 lg:px-20">
    <div class="pointer-events-auto flex items-baseline gap-2 text-[14px] tabular-nums leading-none text-muted" aria-label={t.hud.sections}>
      <span data-stage-counter class="font-semibold text-fg">01</span>
      <span class="text-line" aria-hidden="true">/</span>
      <span data-stage-total>{String(total).padStart(2, '0')}</span>
    </div>
  </div>
</div>
