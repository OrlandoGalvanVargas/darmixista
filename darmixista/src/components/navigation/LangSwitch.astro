---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languages, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  label: string;
}
const { lang, label } = Astro.props;
const entries = Object.entries(languages) as [Lang, string][];
---

<div class="flex items-center font-mono text-[11px] tracking-[0.2em]" role="group" aria-label={label}>
  {
    entries.map(([code, text], i) => (
      <>
        {i > 0 && <span class="mx-2 text-line" aria-hidden="true">/</span>}
        <a
          href={getRelativeLocaleUrl(code, '')}
          hreflang={code}
          lang={code}
          data-lang-link={code}
          aria-current={code === lang ? 'true' : undefined}
          class:list={['transition-colors duration-300', code === lang ? 'text-fg' : 'text-muted hover:text-fg']}
        >
          {text}
        </a>
      </>
    ))
  }
</div>
