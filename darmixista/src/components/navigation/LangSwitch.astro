---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languages, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  label: string;
}
const { lang, label } = Astro.props;
const other = (Object.keys(languages) as Lang[]).find((code) => code !== lang) ?? lang;
---

<a
  href={getRelativeLocaleUrl(other, '')}
  hreflang={other}
  lang={other}
  data-lang-link={other}
  aria-label={label}
  class="lang-link nav-link text-[13px] font-medium tracking-[0.08em]"
>
  <span class="roll" data-roll>{languages[other]}</span>
</a>
