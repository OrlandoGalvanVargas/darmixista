---
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import Layout from '../layouts/Layout.astro';
import { logoMark } from '../lib/logo-mark';
import { languages, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';
const otherHref = other === 'es' ? '/' : '/en/';

const shots = [
  { key: 'projects', label: t.nav.projects, hash: t.desk.hash.projects },
  { key: 'about', label: t.nav.about, hash: t.desk.hash.about },
  { key: 'contact', label: t.nav.contact, hash: t.desk.hash.contact },
] as const;

const config = {
  lang,
  hashes: { home: '', projects: t.desk.hash.projects, about: t.desk.hash.about, contact: t.desk.hash.contact, board: t.desk.hash.board },
  screen: t.desk.screen,
};
const inks = [
  { key: 'black', c: '#1b1d20', label: t.desk.board.colors.black },
  { key: 'red', c: '#d23b3b', label: t.desk.board.colors.red },
  { key: 'blue', c: '#2358c9', label: t.desk.board.colors.blue },
  { key: 'green', c: '#1d9a57', label: t.desk.board.colors.green },
] as const;
const json = JSON.stringify(config).replace(/</g, '\\u003c');
const navMark = logoMark({ id: 'nav', bg: '#0b0b0c', anim: true });
const brand = [...'DARMIXISTA'];
const loadMark = logoMark({ id: 'load', bg: '#0b0b0c', glow: true });
---

<Layout lang={lang}>
  <div class="desk" data-desk data-shot="home" data-menu="closed">
    <div class="desk-canvas" data-desk-canvas></div>
    <div class="desk-shade" aria-hidden="true"></div>

    <header class="desk-nav">
      <a href={lang === 'es' ? '/' : '/en/'} class="desk-brand" data-shot-link="home" aria-label={`Darmixista — ${t.desk.home}`}>
        <svg viewBox="8 4 64 56" fill="none" aria-hidden="true" set:html={navMark} />
        <span class="desk-brand-word" aria-hidden="true">
          {
            brand.map((c, i) => (
              <span class="desk-brand-ch" data-c={c} style={`--d:${i * 28}ms`}>
                {c}
              </span>
            ))
          }
        </span>
      </a>
      <nav class="desk-links" aria-label={t.nav.label}>
        {
          shots.map((s) => (
            <a href={`#${s.hash}`} class="desk-link" data-shot-link={s.key} aria-current="false">
              {s.label}
            </a>
          ))
        }
        <a href={otherHref} class="desk-lang" data-lang-link={other} hreflang={other} aria-label={t.nav.switchTo}>
          {languages[other]}
        </a>
      </nav>
      <button type="button" class="desk-menu-btn" data-menu-toggle data-close-label={t.nav.close} aria-expanded="false" aria-controls="desk-menu">
        <span data-menu-label>{t.nav.menu}</span>
      </button>
    </header>

    <div id="desk-menu" class="desk-menu" data-mobile-menu inert>
      <a href={`#${t.desk.hash.board}`} class="desk-menu-item" data-shot-link="board" aria-current="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l4.5-1L19.5 8a2.1 2.1 0 0 0-3-3L5.5 16z"></path><path d="M14.5 7l2.5 2.5"></path></svg>
        <span>{t.desk.board.name}</span>
      </a>
      <a href={otherHref} class="desk-menu-item" data-lang-link={other} hreflang={other}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18"></path></svg>
        <span>{t.nav.switchTo}</span>
      </a>
    </div>

    <nav class="desk-dock" data-dock aria-label={t.nav.label} inert>
      <span class="desk-dock-glow" aria-hidden="true"></span>
      <a href={lang === 'es' ? '/' : '/en/'} data-shot-link="home" aria-current="true">
        <span class="desk-dock-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11l8-7 8 7v9H4z"></path><path d="M10 20v-6h4v6"></path></svg></span>
        <span>{t.desk.home}</span>
      </a>
      <a href={`#${t.desk.hash.projects}`} data-shot-link="projects" aria-current="false">
        <span class="desk-dock-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="11" rx="1.5"></rect><path d="M2 19h20"></path></svg></span>
        <span>{t.nav.projects}</span>
      </a>
      <a href={`#${t.desk.hash.about}`} data-shot-link="about" aria-current="false">
        <span class="desk-dock-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"></path></svg></span>
        <span>{t.nav.about}</span>
      </a>
      <a href={`#${t.desk.hash.contact}`} data-shot-link="contact" aria-current="false">
        <span class="desk-dock-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg></span>
        <span>{t.nav.contact}</span>
      </a>
    </nav>

    <div class="desk-hero">
      <h1 aria-label={t.desk.name} data-hero-name>
        {
          [...t.desk.name].map((ch) => (
            <span aria-hidden="true" class={ch === ' ' ? 'sp' : undefined}>
              {ch === ' ' ? '\u00a0' : ch}
            </span>
          ))
        }
      </h1>
      <p>{t.hero.role}</p>
    </div>

    <button type="button" class="desk-scroll" data-desk-next aria-label={t.desk.scroll}>
      <span aria-hidden="true"><i></i></span>
    </button>

    <div class="desk-ctl">
      <button type="button" data-zoom="in" aria-label={t.desk.zoomIn}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
      </button>
      <button type="button" data-zoom="out" aria-label={t.desk.zoomOut}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"></path></svg>
      </button>
      <button type="button" data-zoom="reset" aria-label={t.desk.reset}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.6-5.9M20 4v5h-5"></path></svg>
      </button>
    </div>

    <div class="wb" data-wb data-pan="0" role="toolbar" aria-label={t.desk.board.tools}>
      <div class="wb-side">
        <span class="wb-track" aria-hidden="true"><i data-wb-track></i></span>
        <div class="wb-mode">
          <button type="button" data-wb-mode="draw" aria-pressed="true" aria-label={t.desk.board.draw} title={t.desk.board.draw}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l4.5-1L19.5 8a2.1 2.1 0 0 0-3-3L5.5 16z"></path><path d="M14.5 7l2.5 2.5"></path></svg>
          </button>
          <button type="button" data-wb-mode="move" aria-pressed="false" aria-label={t.desk.board.move} title={t.desk.board.move}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 12.5V5.5a1.5 1.5 0 0 1 3 0V11"></path><path d="M11.5 10.5V4a1.5 1.5 0 0 1 3 0v6.5"></path><path d="M14.5 10.5V5.5a1.5 1.5 0 0 1 3 0V13"></path><path d="M17.5 9.5a1.5 1.5 0 0 1 3 0V14a7 7 0 0 1-7 7h-1.2a6 6 0 0 1-4.6-2.2l-3.4-4.2a1.6 1.6 0 0 1 2.4-2.1l1.8 1.8"></path></svg>
          </button>
        </div>
      </div>
      <div class="wb-tray">
        <button type="button" class="wb-tool wb-marker" data-wb-tool="marker" aria-pressed="true" aria-label={t.desk.board.marker} title={t.desk.board.marker} style="--ink:#1b1d20">
          <svg viewBox="0 0 80 24" aria-hidden="true">
            <defs>
              <linearGradient id="wb-barrel" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff"></stop><stop offset=".55" stop-color="#e9ebed"></stop><stop offset="1" stop-color="#b9bec3"></stop></linearGradient>
              <linearGradient id="wb-cap" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".28"></stop><stop offset=".35" stop-color="#fff" stop-opacity="0"></stop><stop offset="1" stop-color="#000" stop-opacity=".35"></stop></linearGradient>
            </defs>
            <path class="wb-ink" d="M1.5 12 L9 8.6 L9 15.4 Z"></path>
            <rect x="8" y="8.2" width="6" height="7.6" rx="1" fill="#7d8287"></rect>
            <rect x="13" y="6.2" width="6" height="11.6" rx="1.6" fill="#d4d8db"></rect>
            <rect x="18" y="5" width="44" height="14" rx="3" fill="url(#wb-barrel)"></rect>
            <rect class="wb-ink" x="22" y="5" width="4" height="14"></rect>
            <rect x="31" y="10" width="20" height="1.4" rx=".7" fill="#9aa0a6"></rect>
            <rect x="31" y="13" width="13" height="1.2" rx=".6" fill="#b3b8bd"></rect>
            <rect class="wb-ink" x="60" y="4" width="18" height="16" rx="4"></rect>
            <rect x="60" y="4" width="18" height="16" rx="4" fill="url(#wb-cap)"></rect>
            <rect class="wb-ink" x="64" y="2" width="12" height="3.4" rx="1.6"></rect>
            <rect x="62" y="6" width="14" height="1.4" rx=".7" fill="#fff" opacity=".35"></rect>
          </svg>
        </button>
        <button type="button" class="wb-tool wb-eraser" data-wb-tool="eraser" aria-pressed="false" aria-label={t.desk.board.eraser} title={t.desk.board.eraser}>
          <svg viewBox="0 0 58 28" aria-hidden="true">
            <defs>
              <linearGradient id="wb-handle" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#4a4f55"></stop><stop offset="1" stop-color="#1d1f22"></stop></linearGradient>
              <pattern id="wb-felt" width="3" height="3" patternUnits="userSpaceOnUse"><rect width="3" height="3" fill="#cfd1d2"></rect><rect width="1" height="1" fill="#b8babb"></rect></pattern>
            </defs>
            <rect x="4" y="15" width="50" height="10" rx="2.2" fill="url(#wb-felt)"></rect>
            <rect x="4" y="22" width="50" height="3" rx="1.5" fill="#a9acae"></rect>
            <rect x="3" y="3" width="52" height="14" rx="6.5" fill="url(#wb-handle)"></rect>
            <rect x="10" y="8" width="38" height="3.2" rx="1.6" fill="#141517"></rect>
            <rect x="6" y="4.2" width="46" height="1.4" rx=".7" fill="#fff" opacity=".18"></rect>
          </svg>
        </button>
        <span class="wb-sep" aria-hidden="true"></span>
        <div class="wb-inks">
          {
            inks.map((k, i) => (
              <button type="button" class="wb-ink-btn" data-wb-color={k.c} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={k.label} title={k.label} style={`--c:${k.c}`} />
            ))
          }
        </div>
      </div>
    </div>

    <div class="desk-loader" data-desk-loader>
      <div class="desk-loader-inner">
        <svg viewBox="8 4 64 56" fill="none" aria-hidden="true" set:html={loadMark} />
        <span class="desk-loader-word">DARMIXISTA</span>
        <span class="desk-loader-bar" aria-hidden="true"><i data-desk-progress></i></span>
        <span class="desk-loader-text" data-desk-status role="status"><span>{t.desk.loading}</span></span>
      </div>
    </div>

    <script type="application/json" data-desk-config set:html={json} />
    <template data-desk-nowebgl>{t.desk.noWebgl}</template>
  </div>
</Layout>

<script>
  import { initDesk } from '../scripts/desk';
  initDesk();
</script>
