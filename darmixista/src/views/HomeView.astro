---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/navigation/Navbar.astro';
import Preloader from '../components/brand/Preloader.astro';
import '@fontsource/instrument-serif/400-italic.css';
import Hero from '../components/sections/Hero.astro';
import HeroName from '../components/sections/HeroName.astro';
import About from '../components/sections/About.astro';
import Stack from '../components/sections/Stack.astro';
import Trajectory from '../components/sections/Trajectory.astro';
import ProjectsCarousel from '../components/projects/ProjectsCarousel.astro';
import ProjectDialogs from '../components/projects/ProjectDialogs.astro';
import Services from '../components/sections/Services.astro';
import Contact from '../components/sections/Contact.astro';
import ContactFormStep from '../components/sections/ContactFormStep.astro';
import { BUSINESS_APPS, MOBILE_PROJECTS, PERSONAL_APPS, WEB_PROJECTS } from '../data/projects';
import { useTranslations } from '../i18n/ui';
import RingsScene from '../components/scene/RingsScene';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

---

<Layout lang={lang}>
  <Preloader />

  <div class="hero-backdrop" data-hero-backdrop aria-hidden="true">
    <div class="hero-geo">
      <HeroName variant="fill" />
    </div>
  </div>

  <div data-rings-layer class="pointer-events-none fixed inset-0 z-0">
    <RingsScene client:only="react" />
  </div>

  <Navbar lang={lang} />

  <main data-stage class="stage z-10">
    <Hero lang={lang} />
    <ProjectsCarousel id="projects" kind="web" title={t.projects.webTitle} projects={WEB_PROJECTS} lang={lang} />
    <ProjectsCarousel id="apps" kind="mobile" title={t.projects.mobileTitle} projects={PERSONAL_APPS} lang={lang} />
    {BUSINESS_APPS.length > 0 && <ProjectsCarousel id="business-apps" kind="mobile" title={t.projects.businessTitle} projects={BUSINESS_APPS} lang={lang} />}
    <About lang={lang} />
    <Stack lang={lang} />
    <Trajectory lang={lang} />
    <Services lang={lang} />
    <Contact lang={lang} />
    <ContactFormStep lang={lang} />
  </main>

  <ProjectDialogs
    lang={lang}
    projects={[
      ...WEB_PROJECTS.map((project) => ({ project, kind: 'web' as const })),
      ...MOBILE_PROJECTS.map((project) => ({ project, kind: 'mobile' as const })),
    ]}
  />

  <noscript>
    <style>
      .stage-section:first-of-type, .hero-backdrop { opacity: 1; visibility: visible; }
      [data-preloader] { display: none !important; }
    </style>
  </noscript>
</Layout>

<script>
  import { initStage } from '../scripts/stage';
  import { initNavigation } from '../scripts/navigation';
  import { runPreloader } from '../scripts/preloader';
  import { initDialogs } from '../scripts/dialogs';
  import { initContact } from '../scripts/contact';
  import { initButtons } from '../scripts/buttons';
  import { initCursor } from '../scripts/cursor';
  import { initHero } from '../scripts/hero';

  initNavigation();
  initDialogs();
  initContact();
  initButtons();
  initCursor();
  initHero();
  initStage({ ready: runPreloader() });
</script>
